    {
      "id": "p0066-b002",
      "kind": "paragraph",
      "source": {
        "text": "Undertale's localization process consisted of three main parts: localizing the text, localizing the art, and reprogramming the game.",
        "raw": "Underta/e's localization process consisted of three main parts: localizing the\ntext, localizing the art, and reprogramming the game.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.28931608,
          0.09327857,
