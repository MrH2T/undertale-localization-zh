    {
      "id": "p0248-b002",
      "kind": "aside",
      "source": {
        "text": "Without a high level of • cooperation between creator and localizer, references can easily be lost in translation",
        "raw": "Without a high level of •\ncooperation between\ncreator and localizer,\nreferences can easily be\nlost in translation",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
