    {
      "id": "p0128-b011",
      "kind": "paragraph",
      "source": {
        "text": "Toby designed Jerry to speak in an outdated and \"irritating meme-y\" way in English. To preserve this character trait in Japanese, the translator dropped all of the original English text and replaced it with roughly similar Japanese Internet slang that feels outdated and annoying. Jerry also tends to use the assertive and masculine Japanese pronoun ore.",
        "raw": "Toby designed Jerry to speak in an outdated and \"irritating meme-y\" way in\nEnglish. To preserve this character trait in Japanese, the translator dropped\nall of the original English text and replaced it with roughly similar Japanese\nInternet slang that feels outdated and annoying. Jerry also tends to use the\nassertive and masculine Japanese pronoun ore.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29658519,
          0.81232143,
          0.88175633,
          0.89858571
        ],
        "mask_bbox": [
