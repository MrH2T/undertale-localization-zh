      "review_issues": []
    },
    {
      "id": "p0143-b006",
      "kind": "paragraph",
      "source": {
        "text": "Japanese tourist spots don't follow the same phrasing pattern to welcome visitors, so the original cultural reference was lost in translation. The core joke of calling one's home \"scenic\" works in any language, though, so this line was given a simple, straightforward translation into Japanese.",
        "raw": "Japanese tourist spots don't follow the same phrasing pattern to welcome\nvisitors, so the original cultural reference was lost in translation. The core joke\nof calling one's home \"scenic\" works in any language, though, so this line was\ngiven a simple, straightforward translation into Japanese.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.08846937,
          0.42952143,
          0.69506972,
          0.49747857
        ],
        "mask_bbox": [
          0.08136524,
          0.42880714,
          0.69711407,
          0.49855
        ],
        "line_ids": [
          19,
          20,
          21,
          22
        ]
      },
      "translation": {
        "text": "日本景点欢迎游客时不用相同的句式，所以这个文化典故在翻译中丢失了。但把自家称为“风景秀丽”的核心笑点，在任何语言里都成立，因此日文直接译出了这句话。",
        "status": "draft",
        "spans": []
      },
