    {
      "id": "p0096-b006",
      "kind": "aside",
      "source": {
        "text": "RIGHT: Winny was the big file-sharing service in Japan for a while in the 2000s",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.1215077,
          0.4471429,
          0.2746687,
          0.5114286
        ],
        "mask_bbox": [
          0.1215077,
          0.4471429,
          0.2746687,
          0.5114286
        ]
      },
      "translation": {
        "text": "右：2000 年代，Winny 曾一度是日本主要的文件分享服务。",
        "status": "draft",
