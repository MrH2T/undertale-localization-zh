    {
      "id": "p0136-b007",
      "kind": "aside",
      "source": {
        "text": "RIGHT: Daihinmin and Daifugo also usually use a standard card deck, but custom sets exist too - some cities even have their own local rules!",
        "raw": "RIGHT: Daihinmin and\nDaifugo also usually\nuse a standard card\ndeck, but custom sets\nexist too - some cities\neven have their own\nlocal rules!",
        "status": "corrected",
        "languages": [
