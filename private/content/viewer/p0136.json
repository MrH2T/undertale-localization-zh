    {
      "id": "p0136-b005",
      "kind": "paragraph",
      "source": {
        "text": "Although card games are popular in Japan, Go Fish isn't as widely known there as it is elsewhere in the world. For that reason, the Undertale translator replaced the Go Fish reference with a different card game that some Japanese children do play: Daihinmin.",
        "raw": "Although card games are popular in Japan, Go Fish isn't as widely known\nthere as it is elsewhere in the world. For that reason, the Undertale translator\nreplaced the Go Fish reference with a different card game that some Japanese\nchildren do play: Daihinmin.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29198215,
          0.40727857,
          0.8892513,
          0.4761
        ],
        "mask_bbox": [
          0.28994153,
