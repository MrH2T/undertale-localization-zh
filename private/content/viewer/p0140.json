    {
      "id": "p0140-b002",
      "kind": "aside",
      "source": {
        "text": "During this battle, the player must dodge bones that scroll by quickly and spell a funny phrase",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.121677,
          0.092857,
          0.270961,
          0.167857
        ],
        "mask_bbox": [
          0.10235160053869263,
          0.09166428571428573,
          0.27327877343830936,
          0.16762142857142856
        ]
      },
      "translation": {
        "text": "在这场战斗中，玩家必须躲开快速掠过的骨头；这些骨头还拼成了一句有趣的话。",
        "status": "draft",
        "spans": []
      },
      "layout": {
        "bbox": [
          0.12282192064643116,
          0.09,
          0.27020822542214856,
