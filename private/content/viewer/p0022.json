    {
      "id": "p0022-b002",
      "kind": "paragraph",
      "source": {
        "text": "Have you ever heard someone tell an inside joke that you weren't in on? Even though you understood the literal words that were being said, the intended meaning was lost on you. This same thing happens in translation.",
        "raw": "Have you ever heard someone tell an inside joke that you weren't in on? Even\nthough you understood the literal words that were being said, the intended\nmeaning was lost on you. This same thing happens in translation.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.28535902,
          0.09482857,
          0.87364447,
          0.14431429
        ],
        "mask_bbox": [
          0.28326429,
