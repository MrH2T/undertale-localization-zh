    {
      "id": "p0217-b008",
      "kind": "caption",
      "source": {
        "text": "The made-up sound effect word popopopo-n became closely tied with magic through excessive repetition",
        "raw": "The made-up sound effect word\npopopopo-n became closely tied with\nmagic through excessive repetition",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
