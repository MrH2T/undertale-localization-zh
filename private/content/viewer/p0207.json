    {
      "id": "p0207-b016",
      "kind": "quote",
      "source": {
        "text": "'' Undertale is fir/I of weird things and jokes. If tl1ere's afimny line in the EN version that doesn't work in the .JP version, it's obviously better to change it to somethingfi1nny rather than try to make it faithful. I'd be glad to help with any of these changes if necessary.",
        "raw": "'' Undertale is fir/I of weird things and jokes. If tl1ere's afimny line in the EN\nversion that doesn't work in the .JP version, it's obviously better to change\nit to somethingfi1nny rather than try to make it faithful. I'd be glad to help\nwith any of these changes if necessary.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.08980108,
          0.73872857,
          0.69139162,
          0.80540714
        ],
        "mask_bbox": [
          0.0884722,
