    {
      "id": "p0094-b007",
      "kind": "aside",
      "source": {
        "text": "RIGHT: “X out of Y recommend” has been copied and parodied for almost 50 years, yet it remains in regular use today",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.1182704,
          0.4692857,
          0.2742651,
          0.5585714
        ],
        "mask_bbox": [
          0.1182704,
          0.4692857,
          0.2742651,
          0.5585714
        ]
      },
      "translation": {
        "text": "右：这种说法被模仿、戏仿了近 50 年，时至今日仍然经常出现。",
        "status": "draft",
        "spans": []
      },
      "layout": {
        "bbox": [
          0.1009377,
          0.4907143,
          0.2701868,
          0.5585714
        ],
        "font_size": 15.5,
        "line_height": 1.4838709677419355,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "right"
      },
      "notes": "原图与截图保留；译文为待审校初稿。",
      "calibration": {
