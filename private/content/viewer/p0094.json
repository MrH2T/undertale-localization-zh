    {
      "id": "p0094-b006",
      "kind": "aside",
      "source": {
        "text": "LEFT: The “X out of Y recommend” phrase really took off in the mid-1970s with Trident chewing gum",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.0988986,
          0.4057143,
          0.2732455,
          0.4657143
