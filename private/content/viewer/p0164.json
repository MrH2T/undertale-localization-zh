        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.46740000285714284,
        "snap_to_guides": true,
        "resize_anchor": "left",
        "gap_before": 12,
        "flow_after": "p0164-b004"
      },
