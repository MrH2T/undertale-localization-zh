    {
      "id": "p0211-b020",
      "kind": "aside",
      "source": {
        "text": "Yodeling is a traditional form of singing that originated in rural regions of Europe. It involves quickly switching back and forth between super-high and super-low notes",
        "raw": "Yodeling is a traditional\nform of singing that\noriginated in rural\nregions of Europe.\nIt involves quickly\nswitching back and forth\nbetween super-high and\nsuper-low notes",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.72927766,
          0.62230714,
          0.88291072,
          0.74094286
        ],
        "mask_bbox": [
          0.72795183,
          0.62159286,
          0.88423655,
          0.74201429
        ],
        "line_ids": [
