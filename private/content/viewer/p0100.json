    {
      "id": "p0100-b004",
      "kind": "paragraph",
      "source": {
        "text": "The Undertale translator encountered an unexpected problem when translating this line, however: the original Japanese version of Illusion of Gaia never mentioned \"snail pie\" - it was originally just \"meat pie\", which doesn't sound nearly as bizarre or memorable.",
        "raw": "The Undertale translator encountered an unexpected problem when\ntranslating this line, however: the original Japanese version of Illusion of Gaia\nnever mentioned \"snail pie\" - it was originally just \"meat pie\", which doesn't\nsound nearly as bizarre or memorable.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.2891716,
          0.32312857,
          0.88922984,
          0.39013571
