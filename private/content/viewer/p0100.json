    {
      "id": "p0100-b005",
      "kind": "aside",
      "source": {
        "text": "I feel that calling it ~ \"meat pie with whipped cream on top\" would make the Illusion of Gaia reference recognizable, but then the snail connection to Toriel's book later on would be lost",
        "raw": "I feel that calling it ~\n\"meat pie with whipped\ncream on top\" would\nmake the Illusion\nof Gaia reference\nrecognizable, but then\nthe snail connection to\nToriel's book later on\nwould be lost",
        "status": "corrected",
        "languages": [
          "en"
