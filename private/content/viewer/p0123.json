          0.68179129,
          0.1446
        ],
        "line_ids": [
          2,
          3
        ]
      },
      "translation": {
        "text": "大阪是日本西部一座大城市及一个府的名称。大阪都市圈规模居日本第二，仅次于东京。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
