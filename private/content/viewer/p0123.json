    {
      "id": "p0123-b002",
      "kind": "paragraph",
      "source": {
        "text": "Osaka is the name of a major city and a prefecture in western Japan. The Osaka metropolitan area is the second largest in Japan, after Tokyo.",
        "raw": "Osaka is the name of a major city and a prefecture in western Japan. The\nOsaka metropolitan area is the second largest in Japan, after Tokyo.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12176158,
          0.1155,
          0.67610254,
          0.14352857
        ],
        "mask_bbox": [
