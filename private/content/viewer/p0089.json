      "region_id": "determination-quote-one"
    },
    {
      "id": "p0089-b004",
      "kind": "quote",
      "source": {
        "text": "• Resolve to continue • Will to live • Refusal to give up/die (appears to be related to fighting spirit in some cases)",
        "raw": "• Resolve to continue\n• Will to live\n• Refusal to give up/die (appears to be related to fighting spirit in\nsome cases)",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.20234921,
          0.24292143,
          0.63728958,
          0.31257857
        ],
        "mask_bbox": [
          0.20102594,
          0.24220714,
          0.63861286,
          0.31365
        ],
        "line_ids": [
          9,
          10,
          11,
          12
        ]
      },
      "translation": {
        "text": "• 坚持下去的决心\n• 求生意志\n• 拒绝放弃／死亡（有时似乎与斗志有关）",
        "status": "draft",
        "spans": []
