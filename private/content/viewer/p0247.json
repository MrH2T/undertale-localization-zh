    {
      "id": "p0247-b003",
      "kind": "aside",
      "source": {
        "text": "In addition to using the first-person pronoun ore, Asriel uses the rude pronoun omae to say \"you\"",
        "raw": "In addition to using\nthe first-person\npronoun ore, Asriel\nuses the rude pronoun\nomae to say \"you\"",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.73428042,
          0.18027857,
          0.87267102,
          0.25386429
