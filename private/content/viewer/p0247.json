    {
      "id": "p0247-b007",
      "kind": "paragraph",
      "source": {
        "text": "Because the original English text didn't include any such pronoun changes at all, it's clear that the translator viewed Asriel's dialogue through Asriel's eyes when translating his text, much as an actor might slip into their character's mindset before performing a scene.",
        "raw": "Because the original English text didn't include any such pronoun changes at\nall, it's clear that the translator viewed Asriel's dialogue through Asriel's eyes\nwhen translating his text, much as an actor might slip into their character's\nmindset before performing a scene.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09921694,
