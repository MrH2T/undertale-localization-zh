        ]
      },
      "translation": {
        "text": "“Bob Johnson”这位独立开发者没有专门的本地化部门。",
        "status": "draft",
        "spans": []
      },
      "layout": {
        "bbox": [
          0.6099734693877551,
          0.7,
          0.8992809523809523,
          0.7342857142857143
        ],
