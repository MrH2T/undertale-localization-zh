    {
      "id": "p0222-b004",
      "kind": "quote",
      "source": {
        "text": "The English language separates words with spaces, but spaces aren't required in Japanese - this complicates the keyword searching process and can result in false positives unless extra precautions are taken",
        "raw": "The English language separates words with spaces, but spaces aren't\nrequired in Japanese - this complicates the keyword searching process\nand can result in false positives unless extra precautions are taken",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.34155973,
          0.29383571,
          0.88542423,
          0.34184286
        ],
        "mask_bbox": [
          0.3046272,
          0.29312143,
          0.88674688,
          0.34291429
        ],
        "line_ids": [
          9,
          10,
          11
        ]
      },
      "translation": {
        "text": "英语用空格分词，日语却不必。这使关键词搜索更复杂，不采取额外措施就可能误判。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
