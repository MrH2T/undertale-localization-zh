    {
      "id": "p0222-b006",
      "kind": "quote",
      "source": {
        "text": "The Japanese language has its own words for things, but it's also absorbed countless English words - this combination results in a slightly larger pool of available keywords",
        "raw": "The Japanese language has its own words for things, but it's also\nabsorbed countless English words - this combination results in a slightly\nlarger pool of available keywords",
        "status": "corrected",
        "languages": [
