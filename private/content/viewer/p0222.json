    {
      "id": "p0222-b005",
      "kind": "quote",
      "source": {
        "text": "The Japanese language includes a dizzying number of homophones (words with the same pronunciation but different meanings), and the lack of kanji support makes it difficult to differentiate them",
        "raw": "The Japanese language includes a dizzying number of homophones\n(words with the same pronunciation but different meanings), and the\nlack of kanji support makes it difficult to differentiate them",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.34203792,
          0.35742143,
          0.87278781,
          0.40642857
        ],
        "mask_bbox": [
