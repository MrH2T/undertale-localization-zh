          0.35670714,
          0.87411047,
          0.4075
        ],
        "line_ids": [
          12,
          13,
          14
        ]
      },
      "translation": {
        "text": "日语有数量惊人的同音词，即读音相同、意思不同的词；这里不支持汉字，因而很难区分。",
        "status": "draft",
        "spans": []
