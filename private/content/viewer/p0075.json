    {
      "id": "p0075-b009",
      "kind": "paragraph",
      "source": {
        "text": "Undertale has its own Japanese abbreviation too: アンテ (ante, “UnTa”). Fortunately, this abbreviation works with both the official and unofficial translations!",
        "raw": "Undertale has its own Japanese abbreviation too: 7/7-(ante, \"UnTa\"). Fortunately,\nthis abbreviation works with both the official and unofficial translations!",
        "status": "corrected",
        "languages": [
          "en",
          "ja"
        ],
        "bbox": [
