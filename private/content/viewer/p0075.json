    {
      "id": "p0075-b008",
      "kind": "paragraph",
      "source": {
        "text": "It's common for popular games in Japan to receive unofficial, abbreviated names. For example, Super Mario Bros. is often shortened to \"SuMari\", and Dragon Quest is often called \"DraQue\".",
        "raw": "It's common for popular games in Japan to receive unofficial, abbreviated\nnames. For example, Super Mario Bros. is often shortened to \"SuMari\", and\nDragon Quest is often called \"DraQue\".",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09342287,
          0.60224286,
          0.66878704,
          0.65288571
        ],
        "mask_bbox": [
          0.09139039,
          0.60152857,
          0.69426415,
          0.65395714
