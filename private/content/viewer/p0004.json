    {
      "id": "p0004-b002",
      "kind": "legal",
      "source": {
        "text": "Other externally sourced media contained in this book, including video game screenshots, are utilized under the following criteria for Fair Use: 1. Utilized copyrighted material is fundamentally transformative in nature and used for educational and illustrative purposes; 2. Utilized copyrighted material is from a publicly available published work; 3. Utilized copyrighted material is of minimal amount and minimal substantiality; 4. Utilized copyrighted material does not deprive the copyright owner of income, potential for income, or freedom of controlling ownership.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.26449912126537783,
          0.126875,
          0.8963093145869947,
          0.249375
        ],
        "mask_bbox": [
          0.26449912126537783,
