    {
      "id": "p0097-b008",
      "kind": "paragraph",
      "source": {
        "text": "After stepping back and looking at the finished Japanese script as a whole, the localizers chose to classify Napstablook as an obake.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.0868432,
          0.4914286,
          0.7090491,
          0.5285714
        ],
        "mask_bbox": [
          0.0868432,
          0.4914286,
          0.7090491,
          0.5285714
        ]
      },
      "translation": {
        "text": "退后一步，通看完成后的日文稿，团队最终选择把 Napstablook 归为 obake。",
        "status": "draft",
