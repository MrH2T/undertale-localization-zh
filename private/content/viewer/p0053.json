    {
      "id": "p0053-b005",
      "kind": "paragraph",
      "source": {
        "text": "Naturally, some imprinted fan-translation players were quick to criticize the new translation. Just the announcement of an official Japanese release prompted these fans to use phrases like \"war criminals\", \"unfaithful\", and \"pointless\".",
        "raw": "Naturally, some imprinted fan-translation players were quick to criticize the new\ntranslation. Just the announcement of an official Japanese release prompted\nthese fans to use phrases like \"war criminals\", \"unfaithful\", and \"pointless\".",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09379867,
          0.3589,
          0.70313346,
          0.4068
        ],
        "mask_bbox": [
