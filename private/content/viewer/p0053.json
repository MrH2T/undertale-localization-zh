    {
      "id": "p0053-b004",
      "kind": "paragraph",
      "source": {
        "text": "Undertale's official Japanese release caused two general groups to form: fans who first experienced the fan translations, and fans who first experienced the official translation.",
        "raw": "Underta/e's official Japanese release caused two general groups to form: fans\nwho first experienced the fan translations, and fans who first experienced the\nofficial translation.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09331989,
          0.29343571,
          0.69016586,
          0.34268571
