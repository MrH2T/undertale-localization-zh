    {
      "id": "p0053-b012",
      "kind": "paragraph",
      "source": {
        "text": "The practice of retranslation has probably existed as long as language has. Although it's easy to view retranslations in a competitive light, the total number of \"competing translations\" can also be seen as a rough indicator of the source material's cultural significance.",
        "raw": "The practice of retranslation has probably existed as long as language\nhas. Although it's easy to view retranslations in a competitive light, the\ntotal number of \"competing translations\" can also be seen as a rough\nindicator of the source material's cultural significance.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.11775767,
          0.69800714,
