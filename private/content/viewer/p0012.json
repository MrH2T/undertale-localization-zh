    {
      "id": "p0012-b007",
      "kind": "caption",
      "source": {
        "text": "The older a game gets, the harder it is to document its past. So being right there during Undertale's localization was like watching history happen!",
        "raw": "The older a game\ngets, the harder it is to\ndocument its past. So\nbeing right there during\nUndertale's localization\nwas like watching\nhistory happen!",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
