          3,
          4,
          5
        ]
      },
      "translation": {
        "text": "我专做日译英，平时写的大多是日本游戏如何译成英语。不过，Undertale 让我们有机会从另一面看看：英语游戏如何译成日语。",
        "status": "draft",
        "spans": [
          {
            "start": 28,
            "end": 37,
            "italic": true,
            "lang": "en"
          }
        ]
      },
