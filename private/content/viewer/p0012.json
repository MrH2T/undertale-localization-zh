    {
      "id": "p0012-b006",
      "kind": "paragraph",
      "source": {
        "text": "In short, Undertale offers us a rare opportunity to see how English-to .Japanese game translation works, and in unprecedented detail. So when the game's creator suggested I write a Legends of Localization book about the Japanese version of Undertale, I jumped at the chance.",
        "raw": "In short, Undertale offers us a rare\nopportunity to see how English-to\n.Japanese game translation works, and\nin unprecedented detail. So when\nthe game's creator suggested I write\na Legends ofL ocalization book about\nthe Japanese version of Undertale, I\njumped at the chance.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.60649134,
          0.71282857,
          0.89548233,
          0.85372857
        ],
        "mask_bbox": [
          0.60518219,
          0.71211429,
          0.89679148,
          0.8548
        ],
        "line_ids": [
