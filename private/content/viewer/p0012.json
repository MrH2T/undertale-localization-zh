    {
      "id": "p0012-b002",
      "kind": "paragraph",
      "source": {
        "text": "Because I specialize in Japanese-to-English translation, I usually write about how games are translated from Japanese into English. But Undertale gives us a chance to look at the opposite side of things: how English games are translated into Japanese.",
        "raw": "Because I specialize in Japanese-to-English translation, I usually write about\nhow games are translated from Japanese into English. But Undertale gives us a\nchance to look at the opposite side of things: how English games are translated\ninto Japanese.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.28808465,
          0.09019286,
          0.88698289,
          0.15710714
        ],
        "mask_bbox": [
          0.28607056,
          0.08947857,
          0.89478747,
          0.15817857
        ],
        "line_ids": [
