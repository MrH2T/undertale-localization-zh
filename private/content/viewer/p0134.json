    {
      "id": "p0134-b002",
      "kind": "aside",
      "source": {
        "text": "\"Popsicle\" is one of ~ those weird words that's technically a brand name, but has transformed over time into a general-use word",
        "raw": "\"Popsicle\" is one of ~\nthose weird words\nthat's technically a\nbrand name, but has\ntransformed over time\ninto a general-use\nword",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12825316,
          0.09219286,
          0.28268314,
          0.19615
        ],
        "mask_bbox": [
