    {
      "id": "p0134-b003",
      "kind": "paragraph",
      "source": {
        "text": "A food item called the \"Bisicle\" is available for purchase in Snowdin. In English, the item is described as a \"two-pronged popsicle, so you can eat it twice\".",
        "raw": "A food item called the \"Bisicle\" is available for purchase in Snowdin. In English,\nthe item is described as a \"two-pronged popsicle, so you can eat it twice\".",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29325788,
          0.2649,
          0.90900968,
          0.29601429
        ],
        "mask_bbox": [
          0.28656836,
          0.26418571,
          0.91104917,
          0.29708571
        ],
        "line_ids": [
          21,
          22
        ]
      },
      "translation": {
        "text": "Snowdin 商店出售一种叫“Bisicle”的食物，说明写着：“双头冰棒，所以可以吃两次。”",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.29190162,
          0.26347143,
          0.90900968,
          0.29958571
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.38857142857142857,
        "snap_to_guides": true,
        "resize_anchor": "left"
      },
      "calibration": {
