      "kind": "caption",
      "source": {
        "text": "Toby chats with John Ricciardi - co-founder of 8-4 and Undertale's localization producer - in Roppongi in 2016",
        "raw": "Toby chats with John\nRicciardi - co-founder\nof 8-4 and Undertale's\nlocalization producer\n- in Roppongi in 2016",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
