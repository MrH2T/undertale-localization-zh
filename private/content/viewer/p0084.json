    {
      "id": "p0084-b002",
      "kind": "caption",
      "source": {
        "text": "Flowey's name ~ remained \"Flowey\" in Japanese, partly because the English word \"flower\" is well known in Japan",
        "raw": "Flowey's name ~\nremained \"Flowey\"\nin Japanese, partly\nbecause the English\nword \"flower\" is well\nknown in Japan",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.13291693,
          0.09527857,
          0.28313329,
          0.18229286
        ],
        "mask_bbox": [
          0.13159559,
          0.09456429,
          0.28445463,
          0.18336429
        ],
        "line_ids": [
          2,
          3,
          6,
          8,
          9,
          10
        ]
      },
      "translation": {
        "text": "日语版仍保留了 Flowey 这个名字，部分原因是英语 flower（花）在日本也广为人知。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
