      "review_issues": [],
      "region_id": "flowey-voice"
    },
    {
      "id": "p0084-b004",
      "kind": "paragraph",
      "source": {
        "text": "In Japanese, Flowey begins by speaking in a friendly way that sounds fitting for a happy flower character. He also uses the Japanese personal pronoun boku, which gives off a friendly, boyish vibe. Even after Flowey reveals his cruel, sinister side and switches to a rude Japanese speaking style, he continues to use the lighthearted boku pronoun. This early localization choice makes sense after the player learns Flowey's true identity much later on.",
        "raw": "In Japanese, Flowey begins by speaking in a friendly way that sounds fitting\nfor a happy flower character. He also uses the Japanese personal pronoun\nboku, which gives off a friendly, boyish vibe. Even after Flowey reveals his cruel,\nsinister side and switches to a rude Japanese speaking style, he continues to\nuse the lighthearted boku pronoun. This early localization choice makes sense\nafter the player learns Flowey's true identity much later on.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29448667,
          0.28605,
          0.90607531,
          0.38978571
        ],
        "mask_bbox": [
          0.29195579,
          0.28533571,
          0.90810814,
          0.39085714
        ],
        "line_ids": [
          14,
          15,
          16,
          17,
          18,
          19
        ]
      },
      "translation": {
        "text": "日语版中，Flowey 起初说话也很亲切，很符合一朵快乐小花的形象。他用 boku（我）自称，显得友善而有少年气。即使后来露出残忍、阴险的本性，改用粗鲁的日语说话，他仍然沿用这个轻快的 boku。等玩家在很久以后得知 Flowey 的真实身份时，就能理解游戏早期的这一选择了。",
        "status": "draft",
        "spans": [
          {
            "start": 37,
            "end": 41,
            "italic": true,
            "lang": "en"
          },
          {
            "start": 93,
