    {
      "id": "p0084-b003",
      "kind": "paragraph",
      "source": {
        "text": "The main character encounters a happy monster named Flowey. In English, Flowey uses friendly, welcoming words like \"howdy\", \"golly\", and \"aren'tcha\". But looks and words are deceiving - Flowey is actually sadistic and evil.",
        "raw": "The main character encounters a happy monster named Flowey. In English,\nFlowey uses friendly, welcoming words like \"howdy\", \"golly\", and \"aren'tcha\".\nBut looks and words are deceiving - Flowey is actually sadistic and evil.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29398863,
          0.22197143,
          0.89463045,
          0.27042857
        ],
        "mask_bbox": [
          0.29195579,
          0.22125714,
          0.90810814,
          0.2715
        ],
        "line_ids": [
          11,
          12,
          13
        ]
      },
      "translation": {
        "text": "主角遇到一只快乐的怪物 Flowey。他在英语里用 howdy（你好呀）、golly（哎呀）、aren’tcha（是不是呀）这类亲切、热情的说法。但外表和言语都能骗人——Flowey 其实残忍而邪恶。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.29398863,
          0.22054286,
          0.90607531,
          0.39857143
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.3985714285714286,
        "snap_to_guides": true,
        "resize_anchor": "left"
      },
      "calibration": {
        "bbox": [
          0.29398863,
          0.22054286,
          0.90607531,
          0.39857143
        ],
        "font_size": 20,
