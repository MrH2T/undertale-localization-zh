    {
      "id": "p0172-b005",
      "kind": "paragraph",
      "source": {
        "text": "In short, Temminese makes Temmies sounds hyper-energetic, excitable, upbeat, and positive. These qualities, combined with their butchering of the English language, make the Temmies' dialogue funny, endearing, and quotable.",
        "raw": "In short, Temminese makes Temmies sounds hyper-energetic, excitable,\nupbeat, and positive. These qualities, combined with their butchering of the\nEnglish language, make the Temmies' dialogue funny, endearing, and quotable.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.2978652,
          0.37375,
          0.90131714,
          0.42201429
        ],
        "mask_bbox": [
          0.29530496,
          0.37303571,
          0.90669262,
          0.42308571
        ],
        "line_ids": [
          28,
          29,
          30
        ]
      },
      "translation": {
        "text": "Temmie 语让这些角色显得精力过剩、容易兴奋、乐观积极。再加上它们对英语的胡乱糟蹋，台词便既好笑、惹人喜欢，又让人忍不住引用。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.2976255,
          0.37232143,
          0.90465259,
          0.42558571
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.9242857142857143,
        "snap_to_guides": true,
        "resize_anchor": "left",
