    {
      "id": "p0172-b002",
      "kind": "aside",
      "source": {
        "text": "Note that \"Temminese\" is just an unofficial name I made up for convenience's sake - I've never heard anyone say it before, not even Toby",
        "raw": "Note that \"Temminese\"\nis just an unofficial\nname I made up for\nconvenience's sake\n- I've never heard\nanyone say it before,\nnot even Toby",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12731845,
          0.09180714,
          0.27232399,
          0.19505
        ],
        "mask_bbox": [
