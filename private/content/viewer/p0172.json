    {
      "id": "p0172-b007",
      "kind": "aside",
      "source": {
        "text": "In EarthBound, beings known as \"Mr. Saturn\" speak strangely and with a weird font",
        "raw": "In EarthBound, beings\nknown as \"Mr. Saturn\"\nspeak strangely and\nwith a weird font",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.13263274,
          0.43847143,
          0.27381322,
          0.49543571
        ],
        "mask_bbox": [
          0.13130672,
          0.43775714,
          0.27513924,
          0.49650714
        ],
        "line_ids": [
          32,
          33,
          35,
          37
        ]
      },
      "translation": {
        "text": "EarthBound 中，名为 Mr. Saturn 的生物说话很奇怪，字体也很奇怪。",
        "status": "draft",
