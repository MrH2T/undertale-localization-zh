    {
      "id": "p0062-b002",
      "kind": "paragraph",
      "source": {
        "text": "Not all localization projects are the same - a massive, big-budget game might call for a large team of translators and editors with specialized skill sets, while a small indie game might only warrant a single person juggling multiple responsibi Ii ties.",
        "raw": "Not all localization projects are the same - a massive, big-budget game might\ncall for a large team of translators and editors with specialized skill sets, while\na small indie game might only warrant a single person juggling multiple\nresponsibi Ii ties.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.290484,
          0.09139286,
          0.87675866,
          0.15787143
        ],
        "mask_bbox": [
