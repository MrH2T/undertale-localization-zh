    {
      "id": "p0086-b005",
      "kind": "paragraph",
      "source": {
        "text": "In English, Torie! speaks with a polite, motherly tone. In Japanese, she uses an equivalent speaking style that conveys politeness and gentleness. She also uses the personal pronoun watashi, which portrays her as a polite, caring woman.",
        "raw": "In English, Torie! speaks with a polite, motherly tone. In Japanese, she uses an\nequivalent speaking style that conveys politeness and gentleness. She also uses\nthe personal pronoun watashi, which portrays her as a polite, caring woman.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29186811,
          0.36053571,
          0.8924949,
          0.40849286
        ],
