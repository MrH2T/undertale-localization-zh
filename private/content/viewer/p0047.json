    {
      "id": "p0047-b002",
      "kind": "paragraph",
      "source": {
        "text": "After its release in 2015, Undertale enjoyed major success in almost every way.",
        "raw": "After its release in 2015, Undertale enjoyed major success in almost every way.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
