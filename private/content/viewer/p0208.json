    {
      "id": "p0208-b003",
      "kind": "paragraph",
      "source": {
        "text": "A character named Burgerpants works at the Mettaton-themed restaurant in Hotland. In English, Burgerpants speaks in a cheerful and polite manner when speaking as an employee, but quickly shifts to a variety of hyper-casual speech styles whenever he drops his professional persona.",
        "raw": "A character named Burgerpants works at the Mettaton-themed restaurant in\nHotland. In English, Burgerpants speaks in a cheerful and polite manner when\nspeaking as an employee, but quickly shifts to a variety of hyper-casual speech\nstyles whenever he drops his professional persona.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29521981,
          0.25234286,
          0.90142053,
          0.32043571
        ],
        "mask_bbox": [
