    {
      "id": "p0180-b005",
      "kind": "paragraph",
      "source": {
        "text": "Hamburger Helper is an American packaged food product meant to simplify the meal-cooking process - the purchaser only needs to add hamburger meat before cooking. Because Hamburger Helper isn't widely known in Japan, however, the Undertale translator changed this line to say \"Instant Food\" instead.",
        "raw": "Hamburger Helper is an American packaged food product meant to simplify the\nmeal-cooking process - the purchaser only needs to add hamburger meat before\ncooking. Because Hamburger Helper isn't widely known in Japan, however, the\nUndertale translator changed this line to say \"Instant Food\" instead.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29729104,
          0.32171429,
          0.90413338,
          0.38910714
        ],
        "mask_bbox": [
          0.29468573,
