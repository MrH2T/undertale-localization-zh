    {
      "id": "p0118-b008",
      "kind": "paragraph",
      "source": {
        "text": "In short, there are parts of the Japanese script that provide small details not present in the English script - not because anything was intentionally changed, but simply because of how the two languages work.",
        "raw": "In short, there are parts of the Japanese script that provide small details not\npresent in the English script - not because anything was intentionally changed,\nbut simply because of how the two languages work.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29562027,
          0.76873571,
          0.90502581,
          0.81758571
        ],
        "mask_bbox": [
