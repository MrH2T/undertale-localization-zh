    {
      "id": "p0118-b007",
      "kind": "paragraph",
      "source": {
        "text": "Again, the translator consulted with Toby to determine their relationship. Toby had never considered how these sisters relate age-wise, so he arbitrarily decided that the store owner is the younger sister and the innkeeper is the older sister.",
        "raw": "Again, the translator consulted with Toby to determine their relationship. Toby\nhad never considered how these sisters relate age-wise, so he arbitrarily decided\nthat the store owner is the younger sister and the innkeeper is the older sister.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29330372,
          0.70377857,
          0.89932118,
          0.75227143
        ],
        "mask_bbox": [
