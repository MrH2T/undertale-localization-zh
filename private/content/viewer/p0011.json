    {
      "id": "p0011-b002",
      "kind": "paragraph",
      "source": {
        "text": "My name is Clyde Mandelin, but I'm more commonly known on line as \"Tomato\" or just \"Mato\". I'm a professional Japanese-to-English translator and have been in the industry for about twenty years. I specialize in translating Japanese movies, anime, games, and other entertainment into English.",
        "raw": "My name is Clyde Mandelin, but I'm more commonly known on line as\n\"Tomato\" or just \"Mato\". I'm a professional Japanese-to-English translator and\nhave been in the industry for about twenty years. I specialize in translating\nJapanese movies, anime, games, and other entertainment into English.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09732059,
          0.09040714,
          0.70115334,
          0.15695714
        ],
        "mask_bbox": [
          0.0953065,
          0.08969286,
          0.71286524,
          0.15802857
        ],
        "line_ids": [
