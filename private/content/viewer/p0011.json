          5
        ]
      },
      "translation": {
        "text": "我叫 Clyde Mandelin，不过大家在网上更熟悉的名字是“Tomato”，或简称“Mato”。我是一名职业日译英译者，从业约二十年，主要将日本电影、动画、游戏及其他娱乐作品译成英语。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.10371531,
          0.08897857,
          0.71085115,
          0.16052857
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.43357142857142855,
        "snap_to_guides": true,
        "resize_anchor": "left"
      },
      "calibration": {
