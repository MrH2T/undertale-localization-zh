    {
      "id": "p0095-b007",
      "kind": "aside",
      "source": {
        "text": "It’s crazy how even a tiny thing like this shop can have such a big effect on later events in the game",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.7272006,
          0.4621429,
          0.882228,
          0.5407143
