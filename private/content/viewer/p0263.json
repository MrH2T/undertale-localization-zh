    {
      "id": "p0263-b004",
      "kind": "paragraph",
      "source": {
        "text": "Anyway, looking back now, it feels like I just finished taking and finished teaching a two-semester university course on media translation. Hopefully this look at Underta/e's localization has been educational and entertaining for you, too.",
        "raw": "Anyway, looking back now, it feels like I just finished taking and finished teaching\na two-semester university course on media translation. Hopefully this look at\nUnderta/e's localization has been educational and entertaining for you, too.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09849787,
          0.25578571,
          0.70712469,
          0.30468571
        ],
        "mask_bbox": [
