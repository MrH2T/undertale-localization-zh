    {
      "id": "p0263-b007",
      "kind": "paragraph",
      "source": {
        "text": "There were many other topics I had hoped to cover in this book, but could never find quite the right place to put them. So here are a few other points of interest if you've come this far:",
        "raw": "There were many other topics I had hoped to cover in this book, but could\nnever find quite the right place to put them. So here are a few other points of\ninterest if you've come this far:",
        "status": "corrected",
        "languages": [
