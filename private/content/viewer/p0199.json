    {
      "id": "p0199-b010",
      "kind": "paragraph",
      "source": {
        "text": "Undertale's translator honored Toby's unusual wish and translated the guards' indirect English quotes back into Japanese as-is. This resulted in Japanese text that is recognizable as a Kitchen reference, but with noticeably different wording.",
        "raw": "Undertale's translator honored Toby's unusual wish and translated the guards'\nindirect English quotes back into Japanese as-is. This resulted in Japanese\ntext that is recognizable as a Kitchen reference, but with noticeably different\nwording.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09677048,
          0.71624286,
          0.69442987,
          0.78341429
        ],
        "mask_bbox": [
