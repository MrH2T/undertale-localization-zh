    {
      "id": "p0238-b011",
      "kind": "paragraph",
      "source": {
        "text": "Because the Japanese language has a wider variety of personal pronouns than the English language, this unwavering use of boku gives Japanese players an extra layer of insight into Flowey's character that isn't seen in the English script.",
        "raw": "Because the Japanese language has a wider variety of personal pronouns than\nthe English language, this unwavering use of boku gives Japanese players an\nextra layer of insight into Flowey's character that isn't seen in the English script.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29934509,
          0.75352857,
          0.8975783,
          0.80247143
        ],
        "mask_bbox": [
