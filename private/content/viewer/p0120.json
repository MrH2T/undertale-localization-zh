    {
      "id": "p0120-b004",
      "kind": "quote",
      "source": {
        "text": "WHEN’S THE HUMAN SHOWING UP??? I WANT TO LOOK MY SUNDAY BEST... OR AT LEAST MY TUESDAY PRETTY-GOOD.",
        "raw": "WREN'S THE HUMAN SHOWING UP??? I WANT TO LOOK MY\nSUNDAY BEST. .. OR AT LEAST MY TUESDAY PRETTY-GOOD.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.33816908,
          0.30267143,
          0.8509811,
          0.33412857
