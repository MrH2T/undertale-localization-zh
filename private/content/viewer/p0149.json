    {
      "id": "p0149-b004",
      "kind": "caption",
      "source": {
        "text": "Conversely, \"flawless\" was kept intact in the Japanese version of One Step From Eden (2020), but the phrase \"battle won\" was simplified to \"victory\"",
        "raw": "Conversely, \"flawless\" was kept intact in the Japanese version of One Step From Eden\n(2020), but the phrase \"battle won\" was simplified to \"victory\"",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12028504,
          0.536,
          0.65569292,
          0.56217143
        ],
        "mask_bbox": [
          0.11895219,
          0.53528571,
          0.65702578,
          0.56324286
        ],
        "line_ids": [
          9,
          10
        ]
      },
      "translation": {
        "text": "相反，One Step From Eden（2020）日语版保留了 flawless，却把 battle won（战斗获胜）简化成了 victory（胜利）。",
        "status": "draft",
        "spans": [
          {
            "start": 3,
            "end": 21,
            "italic": true,
            "lang": "en"
          }
        ]
      },
