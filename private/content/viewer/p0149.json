    {
      "id": "p0149-b003",
      "kind": "caption",
      "source": {
        "text": "The English word \"flawless\" was replaced with the more recognizable English word \"perfect\" in the Japanese version of Valorant (2020)",
        "raw": "The English word \"flawless\" was replaced with the more recognizable English word\n\"perfect\" in the Japanese version of Valorant (2020)",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.11307737,
          0.3539,
          0.64089823,
          0.37889286
        ],
        "mask_bbox": [
          0.11174452,
          0.35318571,
          0.64223109,
          0.37996429
        ],
        "line_ids": [
          7,
          8
        ]
      },
      "translation": {
        "text": "Valorant（2020）日语版把 flawless（完美无缺）换成了日本玩家更容易认得的 perfect（完美）。",
        "status": "draft",
        "spans": [
          {
            "start": 0,
            "end": 8,
            "italic": true,
            "lang": "en"
          }
