    {
      "id": "p0149-b006",
      "kind": "caption",
      "source": {
        "text": "This victory message in the original Japanese version of Dark Souls (2011) uses very simple English intended for Japanese players, while the English localization uses a larger vocabulary to rephrase the message in a more natural way",
        "raw": "This victory message in the original Japanese version of Dark Souls (2011) uses very\nsimple English intended for Japanese players, while the English localization uses a larger\nvocabulary to rephrase the message in a more natural way",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.11995696,
          0.78419286,
