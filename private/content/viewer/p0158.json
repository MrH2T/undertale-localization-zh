    {
      "id": "p0158-b006",
      "kind": "paragraph",
      "source": {
        "text": "After leaving Snowdin, the main character reaches a region named \"Waterfall\" in the English version of Undertale. Note that \"Waterfall\" is the actual name of the place - it isn't simply \"a waterfall\" in the general sense.",
        "raw": "After leaving Snowdin, the main character reaches a region named \"Waterfall\"\nin the English version of Undertale. Note that \"Waterfall\" is the actual name of\nthe place - it isn't simply \"a waterfall\" in the general sense.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29551616,
          0.34829286,
          0.89880481,
          0.39765
        ],
