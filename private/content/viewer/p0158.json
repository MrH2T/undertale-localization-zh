    {
      "id": "p0158-b005",
      "kind": "aside",
      "source": {
        "text": "Translation and localization are very subjective processes - it's like asking a group of people to draw a clown and then seeing a bunch of different styles of clowns",
        "raw": "Translation and\nlocalization are very\nsubjective processes -\nit's like asking a group\nof people to draw a\nclown and then seeing\na bunch of different\nstyles of clowns",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12992328,
          0.20421429,
          0.27092205,
          0.3227
        ],
        "mask_bbox": [
