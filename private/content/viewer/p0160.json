    {
      "id": "p0160-b004",
      "kind": "paragraph",
      "source": {
        "text": "In Japanese, Aaron uses the friendly, boyish pronoun boku rather than the more \"manly\" pronoun ore. Although he doesn't use pronouns very often, this uncharacteristic use of boku was intended to accentuate his \"creepy\" vibe.",
        "raw": "In Japanese, Aaron uses the friendly, boyish pronoun boku rather than the\nmore \"manly\" pronoun ore. Although he doesn't use pronouns very often, this\nuncharacteristic use of boku was intended to accentuate his \"creepy\" vibe.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29694304,
          0.29977857,
          0.89610617,
          0.34962857
        ],
        "mask_bbox": [
