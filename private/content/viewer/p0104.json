    {
      "id": "p0104-b012",
      "kind": "paragraph",
      "source": {
        "text": "In short, the English and Japanese versions of Undertale treat item names quite differently, while also following the expectations of their specific audiences.",
        "raw": "In short, the English and Japanese versions of Undertale treat item names quite\ndifferently, while also following the expectations of their specific audiences.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29520747,
          0.8725,
          0.90680554,
          0.90348571
        ],
        "mask_bbox": [
          0.28588566,
          0.87178571,
          0.90957965,
          0.90455714
        ],
        "line_ids": [
          47,
          48
        ]
      },
      "translation": {
        "text": "总的来说，Undertale 的英语版和日语版以截然不同的方式处理物品名称，也都符合各自玩家的预期。",
        "status": "draft",
