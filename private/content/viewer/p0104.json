      "kind": "aside",
      "source": {
        "text": "In serious battles, ~ \"Butterscotch Pie\" is instead abbreviated as \"Pie\" in English, while the name remains its full length in Japanese",
        "raw": "In serious battles, ~\n\"Butterscotch Pie\" is\ninstead abbreviated as\n\"Pie\" in English, while\nthe name remains its\nfull length in Japanese",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
