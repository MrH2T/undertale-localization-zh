    {
      "id": "p0082-b006",
      "kind": "paragraph",
      "source": {
        "text": "Undertale takes place in a massive area that exists beneath Mt. Ebott. In English, this area is called the \"Underground\".",
        "raw": "Undertale takes place in a massive area that exists beneath Mt. Ebott. In\nEnglish, this area is called the \"Underground\".",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29483897,
          0.36587857,
