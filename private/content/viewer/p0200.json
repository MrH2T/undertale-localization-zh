    {
      "id": "p0200-b004",
      "kind": "quote",
      "source": {
        "text": "WAIT A SECOND. THAT'S NOT A GLASS OF WATER!!! THAT'S. .. A BOMB!!! OH NO!!! THIS NEWS REPORT. .. IS TURNING INTO A DISASTER REPORT!!!",
        "raw": "WAIT A SECOND. THAT'S NOT A GLASS OF WATER!!!\nTHAT'S. .. A BOMB!!! OH NO!!! THIS NEWS REPORT. ..\nIS TURNING INTO A DISASTER REPORT!!!",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.33544103,
          0.29665714,
          0.77022028,
          0.34495714
