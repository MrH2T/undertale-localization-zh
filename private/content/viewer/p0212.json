    {
      "id": "p0212-b004",
      "kind": "quote",
      "source": {
        "text": "that promise i made to her. .. you /mow what would have happened ifs he hadn't said anything? ... buddy. You'd be dead where you stand.",
        "raw": "that promise i made to her. .. you /mow what would have happened ifs he\nhadn't said anything? ... buddy. You'd be dead where you stand.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.34279657,
          0.33043571,
          0.88016359,
          0.36104286
        ],
        "mask_bbox": [
          0.34146719,
          0.32972143,
          0.88149297,
          0.36211429
        ],
        "line_ids": [
          17,
          18
        ]
      },
      "translation": {
        "text": "我答应过她……你知道，要是她什么都没说，会发生什么吗？……伙计。你现在就死在这里了。",
        "status": "draft",
        "spans": []
