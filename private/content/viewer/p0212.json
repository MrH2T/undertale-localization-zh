    {
      "id": "p0212-b002",
      "kind": "aside",
      "source": {
        "text": "Imagine being longtime ~ friends with the kindest, funniest person alive - like maybe Mr. Rogers from American TV - then suddenly hearing them say, ''I'll kill you if I have to.\"",
        "raw": "Imagine being longtime ~\nfriends with the kindest,\nfunniest person alive -\nlike maybe Mr. Rogers\nfrom American TV -\nthen suddenly hearing\nthem say, ''I'll kill you if\nI have to.\"",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12072837,
          0.09375714,
          0.28553087,
          0.21208571
        ],
        "mask_bbox": [
          0.11939899,
