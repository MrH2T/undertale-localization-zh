    {
      "id": "p0069-b002",
      "kind": "paragraph",
      "source": {
        "text": "For a number of reasons, the technical side of Undertale's Japanese release took far longer than the text translation itself.",
        "raw": "For a number of reasons, the technical side of Underta/e's Japanese release took\nfar longer than the text translation itself.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09807955,
