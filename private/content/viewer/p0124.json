          0.25241429,
          0.889735,
          0.30559286
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.6228571428571429,
        "snap_to_guides": true,
        "resize_anchor": "left"
      },
      "calibration": {
