    {
      "id": "p0124-b006",
      "kind": "quote",
      "source": {
        "text": "everyone stops when a stoplight turns red, right? red stoplights mean \"stop\", but think ofb lue as \"stop\", okay? simple, right? in battle, blue means \"stop\".",
        "raw": "everyone stops when a stoplight turns red, right?\nred stoplights mean \"stop\", but think ofb lue as \"stop\", okay?\nsimple, right? in battle, blue means \"stop\".",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.3383778,
          0.46362143,
          0.78938158,
          0.51145
        ],
        "mask_bbox": [
          0.33705159,
