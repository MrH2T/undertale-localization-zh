          0.79070779,
          0.51252143
        ],
        "line_ids": [
          26,
          27,
          28
        ]
      },
      "translation": {
        "text": "日版大意是：信号灯变红，大家就会停下，对吧？红灯表示“停”，不过把蓝色当成“停”，好吗？简单吧？战斗时，蓝色就表示“停”。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
