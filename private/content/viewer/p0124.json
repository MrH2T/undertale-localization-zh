          0.25241429,
          0.889735,
          0.30559286
        ],
        "font_size": 20,
        "leading": 29.0
      },
      "review_issues": []
    },
    {
      "id": "p0124-b004",
      "kind": "quote",
      "source": {
        "text": "imagine a stop sign. when you see a stop sign, you stop, right? stop signs are red. so imagine a blue stop sign. simple, right? when.fighting, think about blue stop signs.",
        "raw": "imagine a stop sign. when you see a stop sign, you stop, right?\nstop signs are red. so imagine a blue stop sign. simple, right?\nwhen.fighting, think about blue stop signs.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.33812276,
          0.31815714,
          0.79754288,
          0.36632857
        ],
        "mask_bbox": [
          0.33679655,
          0.31744286,
          0.7988691,
          0.3674
        ],
        "line_ids": [
          19,
          20,
          21
        ]
      },
      "translation": {
        "text": "想象一个停车标志。看到停车标志，你会停下，对吧？停车标志是红色的。那么，想象一个蓝色停车标志。简单吧？战斗时就想想蓝色停车标志。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
