    {
      "id": "p0052-b002",
      "kind": "paragraph",
      "source": {
        "text": "For the first two years after its original release, Undertale gained a small and wholly devoted following in Japan. As a foreign indie game, however, it didn't catch the attention of mainstream gamers or news outlets during this time.",
        "raw": "For the first two years after its original release, Undertale gained a small and\nwholly devoted following in Japan. As a foreign indie game, however, it didn't\ncatch the attention of mainstream gamers or news outlets during this time.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29315112,
          0.09253571,
          0.88506706,
