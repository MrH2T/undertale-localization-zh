        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.48714285714285716,
        "snap_to_guides": true,
        "resize_anchor": "left",
