          0.5377,
          0.6757222181331842,
          0.62145714
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.6278571428571429,
