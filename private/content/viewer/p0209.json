    {
      "id": "p0209-b003",
      "kind": "paragraph",
      "source": {
        "text": "Previously, a teenage comedian monster named Snowdrake appeared in the Snowdin area. It turns out that his is father is the in-house comedian at the MTT Hotel in Hotland.",
        "raw": "Previously, a teenage comedian monster named Snowdrake appeared in the\nSnowdin area. It turns out that his is father is the in-house comedian at the\nMTT Hotel in Hotland.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.0882828,
          0.22613571,
          0.6706492,
          0.27367857
        ],
        "mask_bbox": [
          0.0821176,
          0.22542143,
          0.70093421,
          0.27475
        ],
        "line_ids": [
          21,
          22,
          23
        ]
      },
      "translation": {
        "text": "前面在雪镇出现过名叫 Snowdrake 的少年喜剧怪物。原来，他父亲是热域 MTT 酒店的驻场喜剧演员。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
