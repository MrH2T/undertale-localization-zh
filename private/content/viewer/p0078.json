          0.27443571,
          0.90352387,
          0.32871429
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.4342857142857143,
        "snap_to_guides": true,
        "resize_anchor": "left"
      },
      "calibration": {
        "bbox": [
          0.296237,
          0.27443571,
          0.90352387,
          0.32871429
        ],
        "font_size": 20,
