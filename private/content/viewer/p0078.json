    {
      "id": "p0078-b006",
      "kind": "caption",
      "source": {
        "text": "It was interesting - and frustrating - to see the official localization criticized for \"mistranslating\" this mountain's name",
        "raw": "It was interesting -\nand frustrating - to\nsee the official\nlocalization criticized\nfor \"mistranslating\"\nthis mountain's name",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.13610972,
          0.09424286,
          0.27213815,
          0.18295
        ],
        "mask_bbox": [
          0.13478895,
          0.09352857,
          0.27345892,
          0.18402143
        ],
        "line_ids": [
          2,
          4,
          5,
          6,
          7,
          8
        ]
      },
      "translation": {
        "text": "看到官方译版因“译错”这座山的名字受到批评，既有趣，又让人无奈。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
