    {
      "id": "p0078-b007",
      "kind": "caption",
      "source": {
        "text": "Mt. ltoi - known as Holy Loly Mountain in Japanese - is a frightful, deadly place full of monsters and darkness, so it's no wonder it served as inspiration for Mt. Ebott",
        "raw": "Mt. ltoi - known as\nHoly Loly Mountain in\nJapanese - is a frightful,\ndeadly place full of\nmonsters and darkness,\nso it's no wonder it\nserved as inspiration\nfor Mt. Ebott",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12268873,
          0.44021429,
          0.27266646,
          0.55948571
        ],
        "mask_bbox": [
