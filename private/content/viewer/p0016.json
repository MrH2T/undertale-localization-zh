    {
      "id": "p0016-b004",
      "kind": "quote",
      "source": {
        "text": "Basically, localization is translation. Localization just changes things a bit when a literal translation doesn't quite work.",
        "raw": "Basically, localization is translation. Localization just changes things a bit\nwhen a literal translation doesn't quite work.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29169973,
          0.20885,
          0.89354649,
          0.24165714
        ],
        "mask_bbox": [
          0.29038568,
          0.20813571,
          0.89486054,
          0.24272857
        ],
        "line_ids": [
          7,
          8
        ]
      },
      "translation": {
        "text": "本地化说到底就是翻译，只是在直译行不通的时候，稍微改动一下。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
