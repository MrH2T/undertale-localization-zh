    {
      "id": "p0016-b010",
      "kind": "paragraph",
      "source": {
        "text": "When we communicate, words are our tools. They're like paintbrushes that we use to paint pictures for others to see. The problem is that if you focus too hard on someone's tools, you risk missing the full picture of what they're actually saying.",
        "raw": "When we communicate, words are our tools. They're like paintbrushes that\nwe use to paint pictures for others to see. The problem is that if you focus\ntoo hard on someone's tools, you risk missing the full picture of what they're\nactually saying.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29308454,
          0.83377143,
          0.87749481,
          0.90012143
        ],
        "mask_bbox": [
