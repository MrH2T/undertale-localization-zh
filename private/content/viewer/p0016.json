    {
      "id": "p0016-b002",
      "kind": "paragraph",
      "source": {
        "text": "Before we dive into Undertale's English-to-Japanese localization, there's one big question that needs answering: what exactly is localization, anyway?",
        "raw": "Before we dive into Underta/e's English-to-Japanese localization, there's one\nbig question that needs answering: what exactly is localization, anyway?",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29211416,
          0.10085714,
          0.87653454,
          0.13188571
        ],
        "mask_bbox": [
