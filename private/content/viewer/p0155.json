    {
      "id": "p0155-b003",
      "kind": "paragraph",
      "source": {
        "text": "Licca-chan's popularity among Japanese children spawned a \"Talk to Licca-chan\" phone service that began operating in 1968. Being old enough to call Licca-chan is almost like a generational rite of passage in some parents' eyes.",
        "raw": "Licca-chan's popularity among Japanese children spawned a \"Talk to\nLicca-chan\" phone service that began operating in 1968. Being old\nenough to call Licca-chan is almost like a generational rite of passage in\nsome parents' eyes.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.11369735,
          0.44852857,
          0.65197091,
