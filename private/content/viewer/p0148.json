    {
      "id": "p0148-b009",
      "kind": "paragraph",
      "source": {
        "text": "The English version of this sequence begins with the message \"HANGOUT START!\". The words \"hang out\" and \"hangout\" aren't well known in Japan, though, so \"hangout\" was replaced with the equivalent Japanese word mattari. Thus the Japanese game displays \"MATTARI START!\" in English before this scene begins.",
        "raw": "The English version of this sequence begins with the message \"HANGOUT\nSTART!\". The words \"hang out\" and \"hangout\" aren't well known in Japan,\nthough, so \"hangout\" was replaced with the equivalent Japanese word mattari.\nThus the Japanese game displays \"MATTARI START!\" in English before this\nscene begins.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29727282,
          0.81910714,
          0.90613153,
          0.90501429
        ],
        "mask_bbox": [
