    {
      "id": "p0182-b008",
      "kind": "paragraph",
      "source": {
        "text": "Soon after, another team member suggested replacing the ice cream truck with a food vehicle that is more common in Japan: a yakiimo (\"roasted sweet potato\") truck. This idea was dropped, however, because it lacked a clear, logical connection to normal sugar.",
        "raw": "Soon after, another team member suggested replacing the ice cream truck\nwith a food vehicle that is more common in Japan: ayakiimo (\"roasted sweet\npotato\") truck. This idea wa dropped, however, because it lacked a clear,\nlogical connection to normal sugar.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29730998,
          0.63811429,
          0.88695251,
          0.70586429
        ],
        "mask_bbox": [
