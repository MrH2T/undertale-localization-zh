    {
      "id": "p0166-b002",
      "kind": "aside",
      "source": {
        "text": "Gerson uses the pronoun ワシ (washi), which is associated with elderly characters in Japanese entertainment.",
        "raw": "Gerson uses the\npronoun '7 ':/ (washi),\nwhich is associated\nwith elderly\ncharacters in Japanese\nentertainment",
        "status": "corrected",
        "languages": [
          "en",
          "ja"
        ],
        "bbox": [
          0.12657523,
          0.09895714,
          0.26854902,
          0.18581429
        ],
        "mask_bbox": [
          0.12525303,
          0.09824286,
          0.26987122,
          0.18688571
        ],
        "line_ids": [
          2,
          3,
          7,
          10,
          13,
          18
        ]
      },
      "translation": {
        "text": "Gerson 使用“ワシ”（washi，我），这是日本娱乐作品中常与老年角色联系在一起的自称。",
        "status": "draft",
        "spans": [
          {
