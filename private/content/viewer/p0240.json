    {
      "id": "p0240-b006",
      "kind": "aside",
      "source": {
        "text": "Players who murder every monster they see are rewarded with one of the most frustrating boss battles of all time",
        "raw": "Players who murder\nevery monster they\nsee are rewarded\nwith one of the most\nfrustrating boss\nbattles of all time",
        "status": "corrected",
        "languages": [
