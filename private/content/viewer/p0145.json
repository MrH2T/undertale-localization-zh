    {
      "id": "p0145-b009",
      "kind": "paragraph",
      "source": {
        "text": "This reference to \"an inch\" wasn't meant to be taken literally, so the translator replaced it with \"one millimeter\". This is a terribly inaccurate conversion, of course, but by straying from the literal meaning of the source text, the translator was able to retain the intended, functional meaning instead.",
        "raw": "This reference to \"an inch\" wasn't meant to be taken literally, so the translator\nreplaced it with \"one millimeter\". This is a terribly inaccurate conversion,\nof course, but by straying from the literal meaning of the source text, the\ntranslator was able to retain the intended, functional meaning instead.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09179966,
          0.74856429,
          0.69292327,
          0.81622143
        ],
        "mask_bbox": [
          0.08281549,
          0.74785,
