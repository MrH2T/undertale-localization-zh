    {
      "id": "p0145-b004",
      "kind": "quote",
      "source": {
        "text": "SANS! PLEASE PICK UP YOUR SOCK! ok. DON'T PUT IT BACK DOWN! MOVE IT! ok. YOU MOVED IT TWO INCHES! MOVE IT TO YOUR ROOM!",
        "raw": "SANS! PLEASE PICK UP YOUR SOCK!\nok.\nDON'T PUT IT BACK DOWN! MOVE IT!\nok.\nYOU MOVED IT TWO INCHES! MOVE IT TO YOUR ROOM!",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
