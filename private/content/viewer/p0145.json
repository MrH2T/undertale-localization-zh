    {
      "id": "p0145-b008",
      "kind": "quote",
      "source": {
        "text": "That lady over there's been going for a walk for a while now. ... but she hasn't moved an inch from where she's standing.",
        "raw": "That lady over there's been going for a walk for a while now. ... but she\nhasn't moved an inch from where she's standing.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.13682249,
          0.7026,
          0.65864882,
          0.73332857
