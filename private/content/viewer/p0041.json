    {
      "id": "p0041-b003",
      "kind": "caption",
      "source": {
        "text": "RPG Maker's easy to-use tools made game development accessible to the average person, and fostered a whole new generation of game developers",
        "raw": "RPG Maker's easy\nto-use tools made\ngame development\naccessible to the\naverage person, and\nfostered a whole new\ngeneration of game\ndevelopers",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
