    {
      "id": "p0002-b003",
      "kind": "legal",
      "source": {
        "text": "Legends of Localization is an examination of the cultural influences and differences that affect Japanese and English games. This book is an educational, history-focused exploration of the Undertale video game, but this book is not official Undertale merchandise in any form.",
        "raw": "",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12960699,
          0.49785714,
          0.42688016,
          0.60357143
        ],
        "mask_bbox": [
          0.12826977,
          0.49714286,
          0.42821737,
          0.60464286
        ],
        "line_ids": []
      },
      "translation": {
        "text": "Legends of Localization 探讨影响日语与英语游戏的文化因素及差异。本书以教育和历史为出发点，研究电子游戏 Undertale，但并非任何形式的 Undertale 官方商品。",
        "status": "draft",
