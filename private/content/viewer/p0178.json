    {
      "id": "p0178-b009",
      "kind": "aside",
      "source": {
        "text": "I feel like an analysis of the zillion different sounds of Japanese laughter could fill its own little textbook",
        "raw": "I feel like an analysis\nof the zillion different\nsounds of Japanese\nlaughter could fill its\nown little textbook",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.13688716,
          0.67020714,
          0.27297591,
          0.74229286
        ],
        "mask_bbox": [
          0.13555647,
          0.66949286,
          0.2743066,
          0.74336429
        ],
        "line_ids": [
          29,
          30,
          31,
          32,
          33
        ]
      },
      "translation": {
        "text": "我觉得，光分析日语里千奇百怪的笑声，就够写一本小教材了。",
        "status": "draft",
        "spans": []
      },
