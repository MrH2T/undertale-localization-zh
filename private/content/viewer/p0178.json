    {
      "id": "p0178-b007",
      "kind": "aside",
      "source": {
        "text": "Similar to Papyrus' laugh, Undyne's sound of aggravation was changed slightly for the Japanese script",
        "raw": "Similar to Papyrus'\nlaugh, Undyne's\nsound of aggravation\nwas changed slightly\nfor the Japanese script",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12975261,
          0.46885714,
          0.27279166,
          0.54060714
        ],
        "mask_bbox": [
          0.12842192,
          0.46814286,
          0.27412235,
          0.54167857
        ],
        "line_ids": [
          17,
          18,
          22,
          24,
          25
        ]
      },
      "translation": {
        "text": "与 Papyrus 的笑声一样，Undyne 发怒时的吼声在日文剧本里也稍作了调整。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
