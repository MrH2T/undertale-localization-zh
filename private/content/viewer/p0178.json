      "id": "p0178-b002",
      "kind": "aside",
      "source": {
        "text": "Undyne uses the mostly neutral personal pronoun わたし (watashi) in Japanese",
        "raw": "Undyne uses the\nmostly neutral personal\npronoun btc: L.,\n(watashi) in Japanese",
        "status": "corrected",
        "languages": [
