    {
      "id": "p0178-b006",
      "kind": "paragraph",
      "source": {
        "text": "Of course, other pronouns could've suited Undyne too - one interesting solution might've been to give her a different pronoun to match her different attitudes.",
        "raw": "Of course, other pronouns could've suited Undyne too - one interesting solution\nmight've been to give her a different pronoun to match her different attitudes.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29752204,
          0.42085,
          0.90881079,
          0.45252857
        ],
        "mask_bbox": [
          0.29272132,
          0.42013571,
          0.91129816,
          0.4536
        ],
        "line_ids": [
          15,
          16
        ]
      },
      "translation": {
        "text": "当然，其他人称代词也可能适合 Undyne。有个有趣的办法，或许是让她随态度变化，使用不同的自称。",
        "status": "draft",
        "spans": []
      },
