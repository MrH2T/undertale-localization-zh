    {
      "id": "p0165-b006",
      "kind": "paragraph",
      "source": {
        "text": "In English, ghosts sometimes say \"oo\" as a stereotypical spooky sound. Hoping to preserve this idea in Japanese, the translator gave the song new lyrics:",
        "raw": "In English, ghosts sometimes say \"oo\"\nas a stereotypical spooky sound. Hoping\nto preserve this idea in Japanese, the\ntranslator gave the song new lyrics:",
        "status": "corrected",
        "languages": [
          "en"
        ],
