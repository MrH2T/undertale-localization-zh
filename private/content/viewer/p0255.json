    {
      "id": "p0255-b006",
      "kind": "quote",
      "source": {
        "text": "If Sans and I started a band, what do you think its name would be? \"CHITEI NO OWARI'' LOL! PS - I'm thinking of having Sans be our DJ.",
        "raw": "If Sans and I started a band, what do you think its name would be?\n\"CHITEI NO OWARI''\nLOL!\nPS - I'm thinking of having Sans be our DJ.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.13340589,
          0.43283571,
          0.63779869,
          0.50002857
        ],
        "mask_bbox": [
          0.13208644,
