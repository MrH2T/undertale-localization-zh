    {
      "id": "p0255-b002",
      "kind": "aside",
      "source": {
        "text": "Now that I think about it, the \"CHITEI NO OWARI\" name nicely fits the context of nearing the end of Underta/e",
        "raw": "Now that I think about\nit, the \"CHITEI NO\nOWARI\" name nicely\nfits the context of\nnearing the end of\nUnderta/e",
        "status": "corrected",
        "languages": [
