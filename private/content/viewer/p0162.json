    {
      "id": "p0162-b002",
      "kind": "aside",
      "source": {
        "text": "In Japanese, Onionsan pronounces his sentences like a big, goofy-sounding character",
        "raw": "In Japanese, Onionsan\npronounces his\nsentences like a\nbig, goofy-sounding\ncharacter",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
