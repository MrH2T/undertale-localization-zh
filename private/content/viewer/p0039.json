    {
      "id": "p0039-b007",
      "kind": "caption",
      "source": {
        "text": "Every enemy in Undertale has a uniquely themed \"bullet hell\" pattern that the player must react to in battle",
        "raw": "Every enemy in Underta/e has a uniquely\nthemed \"bullet hell\" pattern that the player\nmust react to in battle",
        "status": "corrected",
