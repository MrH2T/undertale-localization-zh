    {
      "id": "p0039-b006",
      "kind": "caption",
      "source": {
        "text": "Undertale follows the standard Japanese RPG formula of exploring, talking, and fighting, but every aspect of the game has a surprising amount of charm and polish to it",
        "raw": "Underta/e follows the standard Japanese RPG\nformula of exploring, talking, and fighting,\nbut every aspect of the game has a surprising\namount of charm and polish to it",
        "status": "corrected",
        "languages": [
