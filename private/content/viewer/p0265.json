    {
      "id": "p0265-b004",
      "kind": "aside",
      "source": {
        "text": "If you've read the entire book all the way through, then I sincerely thank you and congratulate you",
        "raw": "If you've read the\nentire book all the\nway through, then I\nsincerely thank you and\ncongratulate you",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.73726108,
          0.24779286,
          0.88147771,
          0.32056429
        ],
        "mask_bbox": [
