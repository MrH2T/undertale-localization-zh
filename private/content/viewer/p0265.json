    {
      "id": "p0265-b010",
      "kind": "aside",
      "source": {
        "text": "But seriously, if you do come across any cool localization changes in a game or whatever, share it sometime. I live for this stuff, and I'm always looking for more legends of localization!",
        "raw": "But seriously, if you do come across any cool localization changes in a game\nor whatever, share it sometime. I live for this stuff, and I'm always looking\nfor more legends of localization!",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
