    {
      "id": "p0139-b007",
      "kind": "aside",
      "source": {
        "text": "Sometimes, localization can strengthen the author's original work. This bug in the English version of Underta/e was found and fixed during its Japanese localization, for example",
        "raw": "Sometimes, localization\ncan strengthen the\nauthor's original work.\nThis bug in the English\nversion of Underta/e was\nfound and fixed during\nits Japanese localization,\nfor example",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.73086207,
          0.50625,
          0.88524923,
          0.62570714
        ],
        "mask_bbox": [
          0.7295315,
          0.50553571,
          0.8865798,
          0.62677857
        ],
        "line_ids": [
          27,
          29,
          30,
          31,
          32,
          33,
          34,
          36
        ]
      },
      "translation": {
        "text": "本地化有时也能完善作者的原作。比如，Undertale 英语版的这个漏洞，就是在日语本地化过程中发现并修好的。",
        "status": "draft",
        "spans": [
          {
