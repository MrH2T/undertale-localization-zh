      "kind": "quote",
      "source": {
        "text": "chiri (dust that Aoats in the air and thinly covers things) hokori (small, possibly fluffy clumps of dust) kona (\"powder\")",
        "raw": "chiri (dust that Aoats in the air and thinly covers things)\nhokori (small, possibly fluffy clumps of dust)\nkona (\"powder\")",
        "status": "corrected",
        "languages": [
          "en"
