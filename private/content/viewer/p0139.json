    {
      "id": "p0139-b002",
      "kind": "aside",
      "source": {
        "text": "Never in my life did I imagine I'd be writing a book that explains how to translate dust",
        "raw": "Never in my life did I\nimagine I'd be writing\na book that explains\nhow to translate dust",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.73128172,
          0.09431429,
          0.86783922,
          0.1517
        ],
