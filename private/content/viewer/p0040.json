    {
      "id": "p0040-b008",
      "kind": "caption",
      "source": {
        "text": "Despite the language barrier, Toby's early interest in RPGs would later inspire him to play Japanese games that had never been released in English",
        "raw": "Despite the language barrier, Toby's early interest\nin RPGs would later inspire him to play Japanese\ngames that had never been released in English",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
