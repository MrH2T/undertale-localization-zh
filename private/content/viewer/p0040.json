    {
      "id": "p0040-b007",
      "kind": "caption",
      "source": {
        "text": "Toby's fondness for Japanese RPGs led him to discover EarthBound, which would become a major inspiration in his own future work",
        "raw": "Toby's fondness for Japanese RPGs led him to\ndiscover EarthBound, which would become a\nmajor inspiration in his own future work",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
