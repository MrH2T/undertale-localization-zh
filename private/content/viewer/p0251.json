    {
      "id": "p0251-b007",
      "kind": "quote",
      "source": {
        "text": "3. Dropping the word \"SAVE\" from the scene broke the connection to \"SAVE the World\", the official English title of this scene's background music track",
        "raw": "3. Dropping the word \"SAVE\" from the scene broke the connection to\n\"SAVE the World\", the official English title of this scene's background\nmusic track",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.11279766,
          0.43475,
          0.66609369,
          0.4834
        ],
        "mask_bbox": [
