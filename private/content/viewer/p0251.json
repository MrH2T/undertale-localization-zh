    {
      "id": "p0251-b004",
      "kind": "paragraph",
      "source": {
        "text": "This creative localization choice allowed the Japanese scene to approximate the wordplay in the original English scene. This choice did create new issues to be tackled, however:",
        "raw": "This creative localization choice allowed the Japanese scene to approximate\nthe wordplay in the original English scene. This choice did create new issues to\nbe tackled, however:",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
