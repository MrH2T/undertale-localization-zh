    {
      "id": "p0051-b005",
      "kind": "paragraph",
      "source": {
        "text": "Early Japanese fans relied on unofficial translations to experience Undertale. While clearly the product of passion and good intentions, these translations included genuine mistakes, misunderstandings, and oversights. Even so, the translators' enthusiasm still shone brightly enough to captivate fans.",
        "raw": "Early Japanese fans relied on unofficial translations to experience Undertale.\nWhile clearly the product of passion and good intentions, these translations\nincluded genuine mistakes, misunderstandings, and oversights. Even so, the\ntranslators' enthusiasm still shone brightly enough to captivate fans.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12020589,
          0.31727857,
          0.67783498,
          0.38203571
        ],
        "mask_bbox": [
