      "kind": "aside",
      "source": {
        "text": "Technically, \"execution points\" were renamed \"executor points\" in Japanese, but the \"EXP\" abbreviation still works the same way",
        "raw": "Technically, \"execution\npoints\" were renamed\n\"executor points\" in\nJapanese, but the\n\"EXP\" abbreviation still\nworks the same way",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.72750558,
