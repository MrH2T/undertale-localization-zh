    {
      "id": "p0239-b007",
      "kind": "aside",
      "source": {
        "text": "Flowey says \"LV\" stands for \"Love\" at the start of the game, but the true meaning of \"LV\" is only revealed now",
        "raw": "Flowey says \"LV\" stands\nfor \"Love\" at the start\nof the game, but the\ntrue meaning of \"LV\" is\nonly revealed now",
        "status": "corrected",
        "languages": [
