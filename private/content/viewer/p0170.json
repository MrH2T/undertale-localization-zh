    {
      "id": "p0170-b003",
      "kind": "paragraph",
      "source": {
        "text": "A strange area named Temmie Village exists in Waterfall. Unsurprisingly, almost every monster living in Temmie Village is named \"Temmie''. These Temmie characters look unusual, behave strangely, and speak in a unique way.",
        "raw": "A strange area named Temmie Village exists in Waterfall. Unsurprisingly,\nalmost every monster living in Temmie Village is named \"Temmie''. These\nTemmie characters look unusual, behave strangely, and speak in a unique way.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.2934272,
          0.24657143,
          0.89393128,
          0.29515
