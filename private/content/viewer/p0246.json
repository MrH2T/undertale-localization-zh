    {
      "id": "p0246-b012",
      "kind": "paragraph",
      "source": {
        "text": "Everyone agreed that localizing \"Asriel Dreemur\" into a Japanese anagram brought more downsides than benefits. For this reason, the localization team dropped the anagrnm aspect of Asriel's name and kept his name in line with his original English name.",
        "raw": "Everyone agreed that localizing \"Asriel Dreemur\" into a Japanese anagram\nbrought more downsides than benefits. For this reason, the localization team\ndropped the anagrnm aspect of Asriel's name and kept his name in line with his\noriginal English name.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29439635,
          0.84466429,
          0.90314139,
          0.91140714
        ],
        "mask_bbox": [
