    {
      "id": "p0246-b008",
      "kind": "paragraph",
      "source": {
        "text": "This localization choice offered two benefits: it retained the murderous anagram, and it kept the first name roughly similar in both languages.",
        "raw": "This localization choice offered two benefits: it retained the murderous\nanagram, and it kept the first name roughly similar in both languages.",
        "status": "corrected",
        "languages": [
