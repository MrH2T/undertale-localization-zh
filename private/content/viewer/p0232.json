    {
      "id": "p0232-b008",
      "kind": "paragraph",
      "source": {
        "text": "Naturally, the localization team wanted to preserve the \"dark, mysterious, and unreadable\" vibe in Japanese too. There was one problem, though: the Wingdings font is incompatible with standard Japanese text.",
        "raw": "Naturally, the localization team wanted to preserve the \"dark, mysterious,\nand unreadable\" vibe in Japanese too. There was one problem, though: the\nWingdings font is incompatible with standard Japanese text.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29627403,
          0.58344286,
          0.86464825,
          0.63264286
        ],
        "mask_bbox": [
          0.29178011,
          0.58272857,
          0.90003152,
          0.63371429
        ],
        "line_ids": [
          24,
          25,
          26
        ]
      },
      "translation": {
        "text": "本地化团队自然也想在日文里保留这种“黑暗、神秘、无法阅读”的感觉。但有个问题：Wingdings 字体不支持普通日文。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.29609143,
          0.58201429,
          0.89800266,
