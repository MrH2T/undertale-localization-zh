    {
      "id": "p0232-b009",
      "kind": "paragraph",
      "source": {
        "text": "The localization team found a simple solution to this font problem: decode the Wingding messages into English, translate those messages into Japanese, transcribe the Japanese messages using English letters, then display the new messages with the Wingdings font.",
        "raw": "The localization team found a simple solution to this font problem: decode\nthe Wingding messages into English, translate those messages into Japanese,\ntranscribe the Japanese messages using English letters, then display the new\nmessages with the Wingdings font.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29664937,
          0.64751429,
          0.8820457,
          0.7145
        ],
        "mask_bbox": [
          0.29178011,
          0.6468,
          0.90003152,
          0.71557143
        ],
        "line_ids": [
          27,
          28,
          29,
          30
        ]
      },
      "translation": {
        "text": "团队找到一个简单办法：先把 Wingdings 消息解码成英文，再译成日文，把日文转写成英文字母，最后用 Wingdings 字体显示这段新消息。",
        "status": "draft",
        "spans": []
