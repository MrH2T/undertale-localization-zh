    {
      "id": "p0204-b008",
      "kind": "paragraph",
      "source": {
        "text": "In English, Bratty and Catty use Valleyspeak, an American social dialect that's associated with teenage girls. The translator replicated this in Japanese by giving the characters a similar speech pattern associated with the Japanese gyaru subculture. Both characters use the feminine pronoun atashi.",
        "raw": "In English, Bratty and Catty use Valleyspeak, an American social dialect that's\nassociated with teenage girls. The translator replicated this in Japanese by\ngiving the characters a similar speech pattern associated with the Japanese\ngyaru subculture. Both characters use the feminine pronoun atashi.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29222744,
          0.71767857,
          0.88381697,
          0.78574286
        ],
        "mask_bbox": [
