    {
      "id": "p0147-b004",
      "kind": "quote",
      "source": {
        "text": "That was Gnarly! Tubular! Way Cool! Awesome! Groovy! Mondo! Outrageous! Funky!",
        "raw": "That was Gnarly! Tubular! Way Cool! Awesome! Groovy! Mondo!\nOutrageous! Funky!",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.13851097,
          0.26120714,
          0.62289402,
          0.29157857
        ],
        "mask_bbox": [
          0.13719356,
          0.26049286,
          0.62421143,
          0.29265
        ],
        "line_ids": [
          11,
          12
        ]
      },
      "translation": {
        "text": "刚才真是 Gnarly！Tubular！Way Cool！Awesome！Groovy！Mondo！Outrageous！Funky！（这些都是“太酷、太棒”的俚语。）",
        "status": "draft",
