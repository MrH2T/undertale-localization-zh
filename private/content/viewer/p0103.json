    {
      "id": "p0103-b007",
      "kind": "quote",
      "source": {
        "text": "Okay, here goes! I’m Yuya Sato （｀ェ´） pyaaa!",
        "raw": "Okay, here goes!\nI'm Yuya Sato ( · .:i:') pyaaa!",
        "status": "corrected",
        "languages": [
          "en",
          "ja"
        ],
        "bbox": [
          0.16804761,
          0.69987143,
          0.39465403,
          0.7272
        ],
        "mask_bbox": [
          0.16672528,
          0.69915714,
          0.39597635,
          0.72827143
        ],
        "line_ids": [
          30,
          31
        ]
      },
      "translation": {
        "text": "好，那我先来！\n我叫 Yuya Sato（｀ェ´）pyaaa！",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
