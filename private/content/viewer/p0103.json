    {
      "id": "p0103-b002",
      "kind": "aside",
      "source": {
        "text": "Given Toby's fondness for including Internet jokes in the English script, this Japanese localization choice turned out to be surprisingly fitting",
        "raw": "Given Toby's fondness\nfor including Internet\njokes in the English\nscript, this Japanese\nlocalization choice\nturned out to be\nsurprisingly fitting",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.73228518,
          0.09365714,
          0.86955305,
          0.19702143
        ],
        "mask_bbox": [
          0.73096285,
          0.09294286,
          0.87087538,
          0.19809286
        ],
        "line_ids": [
          2,
          4,
          5,
          6,
          7,
          8,
          9
        ]
      },
      "translation": {
        "text": "Toby 本来就喜欢在英文剧本中塞入网络笑话，因此这个日语本地化选择意外地合拍。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
