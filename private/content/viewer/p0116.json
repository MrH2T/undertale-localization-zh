    {
      "id": "p0116-b007",
      "kind": "aside",
      "source": {
        "text": "I would’ve transcribed Papyrus’ laugh as ニェヘヘヘ (roughly \"nieheheheh\") but that’s just how localization works - everyone makes different decisions.",
        "raw": "I would've transcribed •\nPapyrus' laugh as\n=I\"'-\"'-\" (roughly\n\"nieheheheh\") but\nthat's just how\nlocalization works\n- everyone makes\ndifferent decisions",
        "status": "corrected",
        "languages": [
          "en",
          "ja"
        ],
        "bbox": [
          0.13027321,
          0.56650714,
          0.28393482,
