    {
      "id": "p0235-b002",
      "kind": "paragraph",
      "source": {
        "text": "The secret lab is equipped with an ominous device known as the \"DT Extraction Machine\" in English. The player is supposed to deduce that \"DT\" stands for \"Determination\".",
        "raw": "The secret lab is equipped with an ominous device known as the \"DT\nExtraction Machine\" in English. The player is supposed to deduce that \"DT\"\nstands for \"Determination\".",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09860923,
          0.26352143,
          0.68347682,
          0.31305714
        ],
        "mask_bbox": [
          0.09659206,
          0.26280714,
          0.70495966,
          0.31412857
        ],
        "line_ids": [
          20,
          21,
          22
        ]
      },
      "translation": {
        "text": "秘密实验室里有一台不祥的装置，英文名为“DT Extraction Machine”（DT 提取机）。玩家需要自行推断，DT 代表 Determination（决心）。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.09895215,
          0.26209286,
          0.70294249,
          0.31662857
