    {
      "id": "p0153-b003",
      "kind": "paragraph",
      "source": {
        "text": "After asking to speak to \"G\", the mystery caller apologizes for dialing the wrong number. The apology is in the form of a song accompanied by a short musical melody. The inclusion of this music allows English-speaking players to sing along during this scene.",
        "raw": "After asking to speak to \"G\", the mystery caller apologizes for dialing the wrong\nnumber. The apology is in the form of a song accompanied by a short musical\nmelody. The inclusion of this music allows English-speaking players to sing\nalong during this scene.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09158977,
          0.25876429,
          0.70340332,
          0.32712143
