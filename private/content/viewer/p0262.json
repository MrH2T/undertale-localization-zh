    {
      "id": "p0262-b002",
      "kind": "aside",
      "source": {
        "text": "Top-notch localization work can be hard to come by, so it's heartening to see an indie game like Undertale receive such lavish treatment",
        "raw": "Top-notch localization\nwork can be hard\nto come by, so it's\nheartening to see\nan indie game like\nUndertale receive such\nlavish treatment",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
