          0.86598997,
          0.61275
        ],
        "line_ids": [
          31,
          32,
          33
        ]
      },
      "translation": {
        "text": "• 当直译无法传达某些内容时，本地化能为目标受众保留原作的意图。",
        "status": "draft",
        "spans": []
      },
