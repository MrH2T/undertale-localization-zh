    {
      "id": "p0262-b011",
      "kind": "quote",
      "source": {
        "text": "Translation theory is very different from translation reality - every translation decision has its own unique challenges with unique solutions",
        "raw": "Translation theory is very different from translation reality - every\ntranslation decision has its own unique challenges with unique solutions",
        "status": "corrected",
        "languages": [
