    {
      "id": "p0262-b010",
      "kind": "quote",
      "source": {
        "text": "Translation also involves psychological biases like \"imprinting\" and notions that a translation can only ever be inferior to the source material",
        "raw": "Translation also involves psychological biases like \"imprinting\" and\nnotions that a translation can only ever be inferior to the source material",
        "status": "corrected",
