    {
      "id": "p0262-b009",
      "kind": "quote",
      "source": {
        "text": "Different forms of translation have different limitations - games, for example, have technical, computer-related limitations that sometimes affect the final product, just as movie subtitles must be short and simple enough to be read in the time allotted",
        "raw": "Different forms of translation have different limitations - games, for\nexample, have technical, computer-related limitations that sometimes\naffect the final product, just as movie subtitles must be short and simple\nenough to be read in the time allotted",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
