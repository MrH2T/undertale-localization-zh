    {
      "id": "p0262-b008",
      "kind": "quote",
      "source": {
        "text": "When something will otherwise be lost in a literal or straightforward translation, localization can preserve the original intent for the target audience",
        "raw": "When something will otherwise be lost in a literal or straightforward\ntranslation, localization can preserve the original intent for the\ntarget audience",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.33827939,
          0.56155,
          0.86467299,
          0.61167857
