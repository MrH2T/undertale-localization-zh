    {
      "id": "p0074-b003",
      "kind": "paragraph",
      "source": {
        "text": "Undertale begins with a history lesson: humans and monsters fought in a great war long ago. The humans won, and permanently sealed the monsters beneath a mountain. Much later, a lone human climbs the mountain and accidentally falls into the monsters' underground world ...",
        "raw": "Underta/e begins with a history lesson: humans and monsters fought in a great\nwar long ago. The humans won, and permanently sealed the monsters beneath\na mountain. Much later, a lone human climbs the mountain and accidentally\nfalls into the monsters' underground world ...",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29477972,
          0.13220714,
          0.89121853,
          0.18795714
        ],
        "mask_bbox": [
