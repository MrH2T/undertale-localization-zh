    {
      "id": "p0151-b006",
      "kind": "paragraph",
      "source": {
        "text": "To get around this untranslatable English pun, the translator replaced the English shoe joke with a Japanese shoe joke:",
        "raw": "To get around this untranslatable English pun, the translator replaced the\nEnglish shoe joke with a Japanese shoe joke:",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09300777,
          0.42541429,
          0.66140111,
          0.45622857
        ],
        "mask_bbox": [
          0.08963051,
          0.4247,
          0.708386,
          0.4573
        ],
        "line_ids": [
          17,
          18
        ]
      },
      "translation": {
        "text": "为了绕过这个无法照译的英语双关，译者把英语鞋子笑话换成了日语鞋子笑话：",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
