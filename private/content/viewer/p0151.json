    {
      "id": "p0151-b004",
      "kind": "quote",
      "source": {
        "text": "HUMAN SOULS ARE STRONGER THAN MONSTER SOULS. .. BUT THE SOLES OF OUR SHOES ON THE OTHER HAND. .. ! ARE ABOUT THE SAME.",
        "raw": "HUMAN SOULS ARE STRONGER THAN MONSTER SOULS. ..\nBUT THE SOLES OF OUR SHOES ON THE OTHER HAND. .. !\nARE ABOUT THE SAME.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.13592971,
          0.29770714,
          0.62472199,
          0.34555
        ],
        "mask_bbox": [
          0.13459928,
          0.29699286,
          0.62605243,
          0.34662143
        ],
        "line_ids": [
          11,
          12,
          13
        ]
      },
      "translation": {
        "text": "人类的 SOULS（灵魂）比怪物的更强大……\n但是，我们鞋子的 SOLES（鞋底）……！\n倒是差不多。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
