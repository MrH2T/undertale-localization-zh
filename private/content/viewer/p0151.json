    {
      "id": "p0151-b007",
      "kind": "quote",
      "source": {
        "text": "The secret is in my shoes, you say ...? Heh heh ... Sorry to break it to you, but \"secret shoes\" these are not!",
        "raw": "The secret is in my shoes, you say ...?\nHeh heh ...\nSorry to break it to you, but \"secret shoes\" these are not!",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.13772069,
          0.47179286,
          0.55748376,
          0.52052143
        ],
        "mask_bbox": [
          0.13639025,
          0.47107857,
          0.55881419,
          0.52159286
        ],
        "line_ids": [
          19,
          20,
          21
        ]
      },
      "translation": {
        "text": "你说秘密藏在鞋子里……？\n嘿嘿……\n抱歉让你失望了，这可不是“秘密鞋”！",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.13772069,
          0.47036429,
          0.70633917,
          0.52409286
        ],
        "font_size": 18.5,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "left",
        "auto_height": true,
        "limit_bottom": 0.6135714285714285,
        "snap_to_guides": true,
        "resize_anchor": "left",
