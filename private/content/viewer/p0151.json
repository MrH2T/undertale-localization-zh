    {
      "id": "p0151-b009",
      "kind": "aside",
      "source": {
        "text": "I apologize for occupying some of your brain cells for the next several years with this random Japanese shoe fact",
        "raw": "I apologize for\noccupying some of\nyour brain cells for the\nnext several years with\nthis random Japanese\nshoe fact",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.73507661,
          0.61990714,
          0.87817021,
          0.70765
        ],
        "mask_bbox": [
          0.73374617,
          0.61919286,
          0.87950065,
          0.70872143
        ],
        "line_ids": [
          27,
          30,
          31,
          33,
          34,
          35
        ]
      },
      "translation": {
        "text": "抱歉，这条无关紧要的日本鞋类知识，恐怕要占用你未来好几年的一部分脑细胞了。",
        "status": "draft",
        "spans": []
