    {
      "id": "p0188-b002",
      "kind": "aside",
      "source": {
        "text": "Alphys switches ~ between being confident and being out of her comfort zone, so Toby included many notes about how individual lines should \"feel\" to the player",
        "raw": "Alphys switches ~\nbetween being\nconfident and being\nout of her comfort\nzone, so Toby included\nmany notes about how\nindividual lines should\n\"feel\" to the player",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12367347,
          0.09095714,
          0.28238776,
          0.20992857
        ],
