    {
      "id": "p0110-b003",
      "kind": "paragraph",
      "source": {
        "text": "Before translating Sans' dialogue into Japanese, the translator had to decide which of the many Japanese personal pronouns best fit Sans' character.",
        "raw": "Before translating Sans' dialogue into Japanese, the translator had to decide\nwhich of the many Japanese personal pronouns best fit Sans' character.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29840447,
          0.26159286,
          0.87704268,
          0.29240714
        ],
        "mask_bbox": [
          0.2949187,
          0.26087857,
          0.90072154,
          0.29347857
        ],
        "line_ids": [
          9,
          10
        ]
      },
      "translation": {
        "text": "把 Sans 的台词译成日语之前，译者必须先从众多日语人称代词中，选出最适合他的一个。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.29876016,
          0.26016429,
          0.89868902,
          0.29597857
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.9242857142857143,
        "snap_to_guides": true,
        "resize_anchor": "left"
      },
      "calibration": {
