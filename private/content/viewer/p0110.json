    {
      "id": "p0110-b007",
      "kind": "quote",
      "source": {
        "text": "Oira seems fitting for Sans' normal, laid-back, wisecracking personality",
        "raw": "Oira seems fitting for Sans' normal, laid-back, wisecracking personality",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
