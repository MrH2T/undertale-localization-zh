    {
      "id": "p0110-b002",
      "kind": "aside",
      "source": {
        "text": "Sans uses the personal pronoun オイラ (oira) in the final Japanese script.",
        "raw": "Sans uses the\npersonal pronoun\n71\"17 (oira) in the\nfinal Japanese script",
        "status": "corrected",
        "languages": [
