    {
      "id": "p0110-b008",
      "kind": "quote",
      "source": {
        "text": "Sans' all-lowercase text gives him a distinctive, carefree vibe that's lost in translation, so giving him a similarly distinctive pronoun felt like a natural replacement",
        "raw": "Sans' all-lowercase text gives him a distinctive, carefree vibe that's lost\nin translation, so giving him a similarly distinctive pronoun felt like a\nnatural replacement",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
