    {
      "id": "p0110-b006",
      "kind": "paragraph",
      "source": {
        "text": "Despite the massive response to Sans' new pronoun, the team stuck with oira for several reasons:",
        "raw": "Despite the massive response to Sans' new pronoun, the team stuck with oira\nfor several reasons:",
