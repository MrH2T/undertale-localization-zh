    {
      "id": "p0088-b007",
      "kind": "paragraph",
      "source": {
        "text": "After the localization team chose to translate \"determination\" as ketsui, another problem appeared: what happens when words like \"determination\" or \"determined\" are used in a general sense rather than the Undertale sense?",
        "raw": "After the localization team chose to translate \"determination\" as ketsui,\nanother problem appeared: what happens when words like \"determination\"\nor \"determined\" are used in a general sense rather than the Underta/e sense?",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
