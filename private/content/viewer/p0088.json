    {
      "id": "p0088-b008",
      "kind": "paragraph",
      "source": {
        "text": "Luckily, Toby left notes about this issue too, and the localization staff double checked with him as needed. The issue didn't come up much, but both Toby and 8-4 knew it was important to handle properly.",
        "raw": "Luckily, Toby left notes about this issue too, and the localization staff double\nchecked with him as needed. The issue didn't come up much, but both Toby\nand 8-4 knew it was important to handle properly.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29367621,
          0.68795714,
          0.88128321,
