    {
      "id": "p0088-b002",
      "kind": "caption",
      "source": {
        "text": "It was clear to ~ everyone involved that \"determination\" represented one of the biggest translation choices in the entire game",
        "raw": "It was clear to ~\neveryone involved\nthat \"determination\"\nrepresented one of the\nbiggest translation\nchoices in the entire\ngame",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12202054,
          0.09199286,
          0.27883862,
          0.19607857
