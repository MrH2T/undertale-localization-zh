    {
      "id": "p0264-b004",
      "kind": "paragraph",
      "source": {
        "text": "In short, the teamwork that Toby and 8-4 developed during Underta/e's localization has transformed their basic business relationship into something greater: a genuine bond of friendship and trust.",
        "raw": "In short, the teamwork that Toby and 8-4 developed during Underta/e's\nlocalization has transformed their basic business relationship into something\ngreater: a genuine bond of friendship and trust.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29117495,
          0.34892143,
          0.88283127,
          0.39769286
        ],
        "mask_bbox": [
