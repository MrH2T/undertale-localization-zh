    {
      "id": "p0264-b006",
      "kind": "caption",
      "source": {
        "text": "The English version of this Deltarune line includes an indirect reference to a memorable mistranslation in the classic Japanese RPG, Illusion of Gaia. This reference would be lost on most Japanese Deltarune players, however, so the localization team gave the line a straightforward translation that still conveys the content and mood of the English line",
        "raw": "The English version of this Deltarune line includes an indirect reference to a memorable\nmistranslation in the classic Japanese RPG, Illusion of Gaia. This reference would be lost on most\nJapanese Deltarune players, however, so the localization team gave the line a straightforward\ntranslation that still conveys the content and mood of the English line",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29121551,
