    {
      "id": "p0138-b006",
      "kind": "paragraph",
      "source": {
        "text": "Toby knew these invented words wouldn't translate well, so he always included helpful notes whenever they appeared in the script. He also answered the localization team's follow-up questions regarding these unique words.",
        "raw": "Toby knew these invented words wouldn't translate well, so he always\nincluded helpful notes whenever they appeared in the script. He also answered\nthe localization team's follow-up questions regarding these unique words.",
        "status": "corrected",
