          0.7007872,
          0.84003571
        ],
        "font_size": 20,
        "leading": 29.0
      },
      "review_issues": []
    },
    {
      "id": "p0077-b018",
      "kind": "paragraph",
      "source": {
        "text": "There were two reasons for the team's obsession with finding the right Japanese fonts: a poor font choice would inaccurately represent the original game, and a poor font choice would sour the player's experience.",
        "raw": "There were two reasons for the team's obsession with finding the right\nJapanese fonts: a poor font choice would inaccurately represent the original\ngame, and a poor font choice would sour the player's experience.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09356254,
          0.85159286,
          0.67653854,
          0.90114286
        ],
        "mask_bbox": [
          0.09152569,
          0.85087857,
          0.70282405,
          0.90221429
        ],
        "line_ids": [
          63,
          64,
          65
        ]
      },
      "translation": {
        "text": "团队如此执着于找对日文字体，有两个原因：选错会误传原作，也会损害玩家体验。",
        "status": "draft",
        "spans": []
