        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.9242857142857143,
        "snap_to_guides": true,
        "resize_anchor": "left"
      },
      "calibration": {
        "bbox": [
          0.09443839,
          0.66655714,
          0.7007872,
          0.73863571
        ],
        "font_size": 20,
        "leading": 29.0
      },
      "review_issues": []
    },
    {
      "id": "p0077-b017",
      "kind": "paragraph",
      "source": {
        "text": "Because fonts are so important in Undertale, Toby and 8-4 searched at length for Japanese fonts that \"feel\" like their English counterparts, even if they aren't visually similar. In other words, cheesy English fonts were replaced with cheesy Japanese fonts, generic English game fonts were replaced with generic Japanese fonts, and so on.",
        "raw": "Because fonts are so important in Undertale, Toby and 8-4 searched at length\nfor Japanese fonts that \"feel\" like their English counterparts, even if they\naren't visually similar. In other words, cheesy English fonts were replaced with\ncheesy Japanese fonts, generic English game fonts were replaced with generic\nJapanese fonts, and so on.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09356254,
          0.7502,
          0.7007872,
          0.83646429
        ],
        "mask_bbox": [
          0.09152569,
          0.74948571,
          0.70282405,
          0.83753571
        ],
        "line_ids": [
          58,
          59,
          60,
          61,
          62
        ]
      },
      "translation": {
        "text": "既然字体如此重要，Toby 与 8-4 就花了很久，寻找与英文字体“感觉”相近的日文字体，外观不必相似。也就是说，俗气的英文字体换成俗气的日文字体，常见的英语游戏字体换成常见的日文字体，诸如此类。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.09443839,
          0.74877143,
          0.7007872,
          0.84003571
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify",
        "auto_height": true,
        "limit_bottom": 0.9242857142857143,
        "snap_to_guides": true,
        "resize_anchor": "left",
        "gap_before": 12,
        "flow_after": "p0077-b016"
      },
      "calibration": {
        "bbox": [
