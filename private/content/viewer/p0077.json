    {
      "id": "p0077-b016",
      "kind": "paragraph",
      "source": {
        "text": "Fonts are a big part of the Undertale experience - the game makes heavy use of multiple fonts, and it even contains font-related jokes. What's more, Toby chose many of the game's English fonts because they're generic, cheesy, and not what a serious, professional game developer would ever use.",
        "raw": "Fonts are a big part of the Undertale experience - the game makes heavy use\nof multiple fonts, and it even contains font-related jokes. What's more, Toby\nchose many of the game's English fonts because they're generic, cheesy, and\nnot what a serious, professional game developer would ever use.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.09443839,
          0.66798571,
          0.67840226,
          0.73506429
        ],
        "mask_bbox": [
          0.09152569,
          0.66727143,
          0.70282405,
          0.73613571
        ],
        "line_ids": [
          54,
          55,
          56,
          57
        ]
      },
      "translation": {
        "text": "字体是 Undertale 体验的重要部分。游戏大量使用多种字体，甚至有与字体相关的笑话。而且 Toby 选择许多英文字体，正因为它们普通、俗气，正经的专业游戏开发者绝不会用。",
        "status": "draft",
        "spans": [
          {
            "start": 4,
            "end": 13,
            "italic": true,
            "lang": "en"
          }
        ]
      },
      "annotations": [],
      "layout": {
        "bbox": [
          0.09443839,
          0.66655714,
          0.7007872,
          0.73863571
        ],
        "font_size": 20,
        "line_height": 1.45,
