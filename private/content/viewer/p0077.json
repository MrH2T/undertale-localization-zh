    {
      "id": "p0077-b002",
      "kind": "paragraph",
      "source": {
        "text": "The Japanese language uses three different writing systems: hiragana, katakana, and kanji.",
        "raw": "The Japanese language uses three different writing systems: hiragana,\nkatakana, and kanji.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.11901294,
          0.11135714,
          0.65404158,
          0.13867143
        ],
        "mask_bbox": [
          0.11768899,
          0.11064286,
          0.65536553,
          0.13974286
        ],
        "line_ids": [
          2,
          3
        ]
      },
      "translation": {
        "text": "日语使用三套不同的文字系统：平假名、片假名和汉字。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
