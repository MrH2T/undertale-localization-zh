    {
      "id": "p0163-b007",
      "kind": "paragraph",
      "source": {
        "text": "This new line is a reference to one of Onion Games' most popular games, known in Japan as Yiisha Yamada-kun (\"Yamada the Hero\") and elsewhere as Dandy Dungeon. This localization change has two effects: it makes the reference recognizable in Japanese, and it strengthens the original line's connection between Onionsan and Onion Games.",
        "raw": "This new line is a reference to one of Onion Games' most popular games,\nknown in Japan as Yiisha Yamada-kun (\"Yamada the Hero\") and elsewhere\nas Dandy Dungeon. This localization change has two effects: it makes the\nreference recognizable in Japanese, and it strengthens the original line's\nconnection between Onionsan and Onion Games.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.0924737,
          0.46377143,
          0.66772294,
          0.54941429
        ],
        "mask_bbox": [
