    {
      "id": "p0163-b002",
      "kind": "aside",
      "source": {
        "text": "Other characters say \"hum hum hum\" as a gameplay hint, but Toby's notes paint this particular \"hum hum hum\" as more of a fun reference than a hint",
        "raw": "Other characters say\n\"hum hum hum\" as a\ngameplay hint, but\nToby's notes paint this\nparticular \"hum hum\nhum\" as more of a fun\nreference than a hint",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.72340899,
          0.09084286,
          0.86886751,
          0.19282857
        ],
        "mask_bbox": [
