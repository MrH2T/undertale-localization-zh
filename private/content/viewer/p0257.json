    {
      "id": "p0257-b004",
      "kind": "quote",
      "source": {
        "text": "So, if we're leaving, will my job. .. ? Ugh, and I just got a raise! Well, guess every apple has its CORE, heheh.",
        "raw": "So, if we're leaving, will my job. .. ? Ugh, and I just got a raise!\nWell, guess every apple has its CORE, heheh.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.14916366,
          0.26222857,
          0.59203562,
          0.29374286
