    {
      "id": "p0257-b005",
      "kind": "paragraph",
      "source": {
        "text": "This final sentence uses figurative speech that means \"all good things have a downside\" or \"you gotta take the good with the bad\". The line also contains a pun on the phrase \"apple core\" and the place known as the \"Core\".",
        "raw": "This final sentence uses figurative speech that means \"all good things have a\ndownside\" or \"you gotta take the good with the bad\". The line also contains a\npun on the phrase \"apple core\" and the place known as the \"Core\".",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
