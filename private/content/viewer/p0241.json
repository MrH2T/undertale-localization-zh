    {
      "id": "p0241-b004",
      "kind": "quote",
      "source": {
        "text": "it's a beautiful day outside. birds are singing, flowers are blooming. .. on days like these, kids like you ... Should be burning in hell.",
        "raw": "it's a beautiful day outside.\nbirds are singing, flowers are blooming. ..\non days like these, kids like you ...\nShould be burning in hell.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.14376772,
          0.27467857,
          0.43839844,
          0.34196429
