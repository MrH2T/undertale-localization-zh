    {
      "id": "p0092-b003",
      "kind": "paragraph",
      "source": {
        "text": "A bully eyeball monster named Loox appears in the Underground. In the English script, Loox says in battle:",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.2883029,
          0.2335714,
          0.9107519,
          0.2714286
        ],
        "mask_bbox": [
          0.2883029,
          0.2335714,
          0.9107519,
          0.2714286
        ]
      },
      "translation": {
        "text": "地下世界中有个爱欺负人的眼球怪物，名叫 Loox。在英文版的战斗中，Loox 会说：",
        "status": "draft",
        "spans": []
      },
      "layout": {
        "bbox": [
          0.2923779,
          0.2328571,
          0.9076957,
          0.2742857
        ],
        "font_size": 20,
        "line_height": 1.45,
        "font_weight": 450,
        "background": "transparent",
        "text_align": "justify"
      },
      "notes": "原图与截图保留；译文为待审校初稿。",
      "calibration": {
        "bbox": [
          0.2923779,
          0.2328571,
          0.9076957,
          0.2742857
        ],
        "font_size": 20,
        "leading": 29.0
      },
      "annotations": []
    },
