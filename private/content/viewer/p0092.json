    {
      "id": "p0092-b002",
      "kind": "aside",
      "source": {
        "text": "To be fair, I doubt more than a dozen people recognized the Monster Party quote in English, but Toby made the reference intentionally, so it was important to try to localize",
        "status": "corrected",
        "languages": [
          "en"
        ],
