    {
      "id": "p0038-b004",
      "kind": "paragraph",
      "source": {
        "text": "Undertale is a popular, award-winning video game that debuted in 2015. It was created and developed largely by one person: Toby Fox.",
        "raw": "Underta/e is a popular, award-winning video game that debuted in 2015. It was\ncreated and developed largely by one person: Toby Fox.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.2905982,
          0.17679286,
          0.88952755,
          0.20672143
        ],
        "mask_bbox": [
          0.28679102,
          0.17607857,
          0.89700958,
          0.20779286
        ],
        "line_ids": [
          5,
          6
        ]
      },
      "translation": {
        "text": "Undertale 是一款广受欢迎、屡获奖项的游戏，2015年首次推出，创作和开发工作大多由 Toby Fox 一人完成。",
        "status": "draft",
        "spans": [
          {
            "start": 0,
            "end": 9,
            "italic": true,
            "lang": "en"
          }
        ]
      },
