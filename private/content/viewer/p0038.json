    {
      "id": "p0038-b002",
      "kind": "paragraph",
      "source": {
        "text": "Before we examine Undertafe's English-to-Japanese localization in detail, it's important to know more about Undertale and its history.",
        "raw": "Before we examine Undertafe's English-to-Japanese localization in detail, it's\nimportant to know more about Undertale and its history.",
        "status": "corrected",
        "languages": [
