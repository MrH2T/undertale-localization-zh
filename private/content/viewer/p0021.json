      "id": "p0021-b002",
      "kind": "caption",
      "source": {
        "text": "This Japanese proverb could be literally translated as \"doing life laundry while the ogre is away\". This doesn't make much sense in English though, so the localized script uses a completely different proverb to say roughly the same thing (Game: Final Fantasy IV)",
        "raw": "This Japanese proverb\ncould be literally\ntranslated as \"doing life\nlaundry while the ogre\nis away\". This doesn't\nmake much sense in\nEnglish though, so the\nlocalized script uses a\ncompletely different\nproverb to say roughly\nthe same thing (Game:\nFinal Fantasy IV)",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.7416526,
          0.32985,
          0.89061827,
          0.51119286
        ],
        "mask_bbox": [
