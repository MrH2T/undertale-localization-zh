    {
      "id": "p0114-b007",
      "kind": "paragraph",
      "source": {
        "text": "Because Undertale wasn't originally designed with vertical text in mind, Papyrus' Japanese text often led to graphical glitches and formatting problems. The localization team fixed this by manually editing all of Papyrus' text to use only five characters per line.",
        "raw": "Because Undertale wasn't originally designed with vertical text in mind,\nPapyrus' Japanese text often led to graphical glitches and formatting problems.\nThe localization team fixed this by manually editing all of Papyrus' text to use\nonly five characters per line.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29470924,
          0.67969286,
          0.90509315,
          0.74654286
        ],
        "mask_bbox": [
          0.2871837,
          0.67897857,
          0.90713259,
          0.74761429
        ],
        "line_ids": [
          42,
          43,
          44,
          45
        ]
      },
      "translation": {
        "text": "Undertale 最初并未考虑竖排文字，因此 Papyrus 的日文台词经常出现显示异常和排版问题。本地化团队逐一手动编辑他的全部台词，把每列限制在五个字，解决了这些问题。",
        "status": "draft",
        "spans": [
          {
            "start": 0,
            "end": 9,
            "italic": true,
            "lang": "en"
          }
        ]
      },
      "annotations": [],
