          0.90509315,
          0.35592143
        ],
        "font_size": 20,
        "leading": 29.0
      },
      "review_issues": []
    },
    {
      "id": "p0114-b004",
      "kind": "aside",
      "source": {
        "text": "Like Comic Sans, the Papyrus font has a bad reputation for overuse and misuse",
        "raw": "Like Comic Sans, the\nPapyrus font has a bad\nreputation for overuse\nand misuse",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.12589461,
          0.37862143,
          0.26672812,
          0.43419286
        ],
        "mask_bbox": [
          0.12456898,
          0.37790714,
          0.26805376,
          0.43526429
        ],
        "line_ids": [
          21,
          23,
          25,
          27
        ]
      },
      "translation": {
        "text": "和 Comic Sans 一样，Papyrus 字体也因过度使用和滥用而声名狼藉。",
        "status": "draft",
        "spans": []
      },
      "annotations": [],
      "layout": {
