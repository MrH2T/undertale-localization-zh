    {
      "id": "p0114-b009",
      "kind": "paragraph",
      "source": {
        "text": "All in all, it's clear that the localization team put serious effort into preserving Papyrus' Japanese dialogue, translation-wise and presentation-wise.",
        "raw": "All in all, it's clear that the localization team put serious effort into preserving\nPapyrus' Japanese dialogue, translation-wise and presentation-wise.",
        "status": "corrected",
        "languages": [
