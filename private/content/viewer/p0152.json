      "kind": "quote",
      "source": {
        "text": "'' Character's name beginning with \"G\". .. Actually, it might be suitably bizarre ify ou leave this line completely intact in English",
        "raw": "'' Character's name beginning with \"G\". .. Actually, it might be suitably\nbizarre ify ou leave this line completely intact in English",
        "status": "corrected",
        "languages": [
