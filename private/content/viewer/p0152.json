    {
      "id": "p0152-b004",
      "kind": "quote",
      "source": {
        "text": "Hello! Can I speak to G. .. Wait a second. Is this the wrong number?",
        "raw": "Hello! Can I speak to G. ..\nWait a second. Is this the wrong number?",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.33612976,
          0.30837143,
          0.64569172,
          0.33893571
