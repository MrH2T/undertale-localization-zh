    {
      "id": "p0186-b006",
      "kind": "paragraph",
      "source": {
        "text": "If the player checks the lab's dark walls in the English version of Undertale, the game will state that \"it's too dark to see near the walls\".",
        "raw": "If the player checks the lab's dark walls in the English version of Undertale, the\ngame will state that \"it's too dark to see near the walls\".",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.2951811,
          0.34280714,
          0.8975884,
          0.37355714
