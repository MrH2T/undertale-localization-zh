    {
      "id": "p0024-b008",
      "kind": "paragraph",
      "source": {
        "text": "Different languages use pronouns in different ways. For example, in English we only have \"I/me\" when referring to ourselves, but there are dozens of ways to say \"I\" in Japanese, each with a different connotation.",
        "raw": "Different languages use pronouns in different ways. For example, in English we\nonly have \"I/me\" when referring to ourselves, but there are dozens of ways to\nsay \"I\" in Japanese, each with a different connotation.",
        "status": "corrected",
        "languages": [
          "en"
        ],
        "bbox": [
          0.29033846,
          0.45653571,
          0.89463335,
          0.50503571
        ],
        "mask_bbox": [
