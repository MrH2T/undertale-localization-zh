{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editable book page",
  "type": "object",
  "required": ["schema_version", "pdf_page", "title", "reference_size", "blocks"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "pdf_page": {"type": "integer", "minimum": 1},
    "title": {"type": "string"},
    "reference_size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
  },
  "$defs": {
    "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "span": {
      "type": "object", "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "italic": {"type": "boolean"}, "bold": {"type": "boolean"}, "lang": {"type": "string"}
      }
    },
    "block": {
      "type": "object", "required": ["id", "kind", "source", "translation", "layout"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1},
        "source": {
          "type": "object", "required": ["text", "bbox"],
          "properties": {"text": {"type": "string"}, "bbox": {"$ref": "#/$defs/box"}, "mask_bbox": {"$ref": "#/$defs/box"}}
        },
        "translation": {
          "type": "object", "required": ["text", "spans"],
          "properties": {"text": {"type": "string"}, "spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}}
        },
        "layout": {
          "type": "object", "required": ["bbox", "font_size", "line_height"],
          "properties": {
            "bbox": {"$ref": "#/$defs/box"}, "font_size": {"type": "number", "exclusiveMinimum": 0},
            "line_height": {"type": "number", "exclusiveMinimum": 0}, "flow_after": {"type": "string"},
            "gap_before": {"type": "number"}, "text_align": {"enum": ["left", "right", "center", "justify"]}
          }
        }
      }
    }
  }
}
