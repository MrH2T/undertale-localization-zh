{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study segment",
  "type": "object",
  "required": [
    "id",
    "pdf_page",
    "printed_page",
    "order",
    "kind",
    "regions",
    "source",
    "translation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^p[0-9]{4}-b[0-9]{3}$"
    },
    "pdf_page": {
      "type": "integer",
      "minimum": 1
    },
    "printed_page": {
      "type": [
        "string",
        "null"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "heading",
        "paragraph",
        "caption",
        "aside",
        "list_item",
        "table",
        "image_text"
      ]
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pdf_page",
          "bbox"
        ],
        "properties": {
          "pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "raw",
        "corrected",
        "languages",
        "status",
        "revision"
      ],
      "properties": {
        "raw": {
          "type": "string"
        },
        "corrected": {
          "type": [
            "string",
            "null"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "raw",
            "corrected",
            "reviewed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "translation": {
      "type": "object",
      "required": [
        "zh_hans",
        "status",
        "source_revision"
      ],
      "properties": {
        "zh_hans": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "empty",
            "draft",
            "reviewed"
          ]
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}